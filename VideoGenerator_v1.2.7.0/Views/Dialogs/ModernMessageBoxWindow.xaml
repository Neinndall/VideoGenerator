<Window x:Class="VideoGenerator.Views.ModernMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="490"
        MinWidth="420"
        MaxWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Margin="16"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="16,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="HeaderIcon"
                                                 Kind="InformationOutline"
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="HeaderTitleTextBlock"
                                   Text="NOTIFICATION"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextHighlightBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Style="{DynamicResource IconActionButton}"
                            Width="28" Height="28"
                            Padding="0"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Message -->
            <Grid Grid.Row="1" Margin="20,18,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Badge Icon -->
                <Border Grid.Column="0"
                        x:Name="IconBadgeBorder"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1.5"
                        VerticalAlignment="Top"
                        Margin="0,2,16,0">
                    <materialDesign:PackIcon x:Name="DialogBadgeIcon"
                                             Kind="InformationOutline"
                                             Width="22" Height="22"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptionTextBlock"
                               Text="Notice"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextHighlightBrush}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Message content goes here..."
                               FontSize="11"
                               LineHeight="17"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Footer Action Row -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="16,12">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Buttons are dynamically attached by the code-behind -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
