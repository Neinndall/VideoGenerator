<UserControl x:Class="VideoGenerator.Views.EventRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="{StaticResource WorkspacePagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource WorkspaceHeaderContainer}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="RULE ENGINE" Style="{StaticResource WorkspaceEyebrowText}"/>
                <TextBlock Text="Event mapping" Style="{StaticResource WorkspaceTitleText}" Margin="0,4,0,0"/>
                <TextBlock Text="Orchestrate logic behaviors, thematic groupings, and champion identity mapping." 
                           Style="{StaticResource PageSubtitleText}" 
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <TabControl Grid.Row="1" 
                    Style="{StaticResource LoreEngineTabControl}">
            
            <!-- SECTION 1: EVENT RULES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cogs" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="EVENT RULES" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: REGISTRATION -->
                    <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="14" Height="14"/>
                                    <TextBlock x:Name="RuleFormTitle" Text="NEW BEHAVIOR" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Padding="20">
                                <StackPanel>
                                    <!-- FORM FIELDS -->
                                    <StackPanel x:Name="FormFieldsPanel">
                                        <TextBox x:Name="KeywordBox" materialDesign:HintAssist.Hint="Folder keyword" Style="{StaticResource ModernTextBox}" Margin="0,6,0,12"/>
                                        
                                        <TextBox x:Name="DictKeyBox" materialDesign:HintAssist.Hint="Dict key (auto-generated, editable)" Style="{StaticResource ModernTextBox}" FontFamily="{StaticResource AppMonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20"/>

                                        <ComboBox x:Name="RuleSectionBox" materialDesign:HintAssist.Hint="Behavior category" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,20">
                                            <ComboBoxItem Content="ALL" ToolTip="General purpose rule when no specific category fits"/>
                                            <ComboBoxItem Content="COMBAT" ToolTip="Kill, death, assist, ace, damage events"/>
                                            <ComboBoxItem Content="EMOTES" ToolTip="Joke, taunt, laugh, dance, emote"/>
                                            <ComboBoxItem Content="MOVEMENT" ToolTip="Teleport, recall, dash, run, walk"/>
                                            <ComboBoxItem Content="ITEMS" ToolTip="Buy, shop, purchase, sell, gold"/>
                                            <ComboBoxItem Content="PINGS" ToolTip="MIA, OMW, danger, retreat, assist ping"/>
                                            <ComboBoxItem Content="ABILITIES" ToolTip="Q, W, E, R, spell cast/hit, passive"/>
                                            <ComboBoxItem Content="INTERACTIONS" ToolTip="First encounter, champion/skin interactions"/>
                                            <ComboBoxItem Content="SYSTEM" ToolTip="Shop open/close, game end, surrender, UI"/>
                                            <ComboBoxItem Content="OTHER" ToolTip="Anything that does not fit the above"/>
                                        </ComboBox>

                                        <TextBox x:Name="IconLookupBox" materialDesign:HintAssist.Hint="Icon name or ID (optional)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                                        
                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="IconTypeBox" Grid.Column="0" materialDesign:HintAssist.Hint="Icon category" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0">
                                                <sys:String>generic</sys:String>
                                                <sys:String>champion</sys:String>
                                                <sys:String>item</sys:String>
                                                <sys:String>monster</sys:String>
                                                <sys:String>structure</sys:String>
                                                <sys:String>region</sys:String>
                                                <sys:String>system</sys:String>
                                            </ComboBox>
                                            <ComboBox x:Name="RuleTypeBox" Grid.Column="1" materialDesign:HintAssist.Hint="Rule type" Style="{StaticResource ModernComboBoxStyle}">
                                                <sys:String>Simple</sys:String>
                                                <sys:String>Target</sys:String>
                                                <sys:String>Interaction</sys:String>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- TRANSLATION COMPOSER (shown after registering a rule) -->
                                    <Border x:Name="TranslationComposer" Visibility="Collapsed" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="-20,0,-20,16" Padding="20,20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource SuccessBrush}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="ComposerTitle" Text="Rule Registered" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Background="{StaticResource SurfaceBrush}" Padding="12,10" CornerRadius="8" Margin="0,0,0,20">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Keyword:" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Width="70"/>
                                                        <TextBlock x:Name="ComposerKeywordText" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Section:" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Width="70"/>
                                                        <TextBlock x:Name="ComposerSectionText" Text="-" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Type:" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Width="70"/>
                                                        <TextBlock x:Name="ComposerTypeText" Text="-" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="DICT KEY" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                            <Border Background="{StaticResource SurfaceBrush}" Padding="0" CornerRadius="6" Margin="0,0,0,24">
                                                <TextBox x:Name="TransKeyBox" Text="event_key" FontFamily="{StaticResource AppMonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="13" Background="Transparent" BorderThickness="0" Padding="12,10" materialDesign:HintAssist.Hint="Translation key"/>
                                            </Border>

                                            <TextBlock Text="TRANSLATIONS" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                            <StackPanel Margin="0,0,0,24">
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="EN" FontSize="9" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TransENBox" Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="English"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="ES" FontSize="9" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TransESBox" Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="Spanish"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="TR" FontSize="9" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TransTRBox" Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="Turkish"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="SAVE &amp; NEXT" Click="SaveTranslation_Click" Style="{StaticResource ModernPrimaryButton}" Height="44" FontWeight="Black" FontSize="11" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="NEW RULE" Click="SkipTranslation_Click" Style="{StaticResource ModernSecondaryButton}" Height="44" FontSize="11" Padding="24,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border x:Name="RegisterButtonBar" Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SaveRuleButton" Content="REGISTER EVENT" Click="AddRule_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                                    <Button x:Name="CancelEditButton" Grid.Column="1" Content="CANCEL" Click="CancelEdit_Click" Visibility="Collapsed" Style="{StaticResource ModernSecondaryButton}" Height="52" FontWeight="Black" Padding="18,0" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT PANEL: REPOSITORY -->
                    <Border Grid.Column="1" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Title Header -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="RULES REPOSITORY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Column Headers (dark bg, no icons) -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KEYWORD" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="DICT KEY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="ICON / LOOKUP" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding RuleManager.Rules}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TranslationKey}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconType}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11"/>
                                                    <TextBlock Text="{Binding IconLookup}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Opacity="0.7" Margin="6,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconLookup}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconLookup}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource HUDBorder}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Button Grid.Column="4" Click="EditRule_Click" Style="{StaticResource IconActionButton}" Foreground="{StaticResource AccentBrush}" Width="30" Height="30" ToolTip="Edit rule">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                </Button>
                                                <Button Grid.Column="5" Click="DeleteRule_Click" Style="{StaticResource DangerIconButton}" Width="30" Height="30" ToolTip="Delete rule">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 2: GROUPS -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewGridOutline" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="GROUPS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlusOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="14" Height="14"/>
                                    <TextBlock Text="NEW GROUP" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBox x:Name="GroupNameBox" materialDesign:HintAssist.Hint="Group Name (e.g. Freljord)" Style="{StaticResource ModernTextBox}" Margin="0,6,0,16"/>
                                    <ComboBox x:Name="GroupCategoryBox" materialDesign:HintAssist.Hint="Category" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,16">
                                        <sys:String>Region</sys:String>
                                        <sys:String>Skinline</sys:String>
                                        <sys:String>Class</sys:String>
                                        <sys:String>Role</sys:String>
                                        <sys:String>Custom</sys:String>
                                    </ComboBox>
                                    <TextBox x:Name="ChampionsBox" materialDesign:HintAssist.Hint="Champions (Comma separated)" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="140" VerticalContentAlignment="Top" Padding="12" Margin="0,0,0,16"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <Button Content="ADD GROUP" Click="AddGroup_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Group" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="GROUPS REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="CATEGORY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="CHAMPIONS" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding GroupManager.Groups}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ChampionsRaw}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="{StaticResource AppMonoFontFamily}"/>
                                                <Button Grid.Column="3" Click="DeleteGroup_Click" Style="{StaticResource DangerIconButton}" Width="30" Height="30">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 3: CHAMPIONS & ALIASES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountMultiple" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="CHAMPIONS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>
 
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlusOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="14" Height="14"/>
                                    <TextBlock Text="NEW CHAMPION / ALIAS" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBox x:Name="AliasDisplayBox" materialDesign:HintAssist.Hint="Champion Name (e.g. Locke)" Style="{StaticResource ModernTextBox}" Margin="0,6,0,16"/>
                                    <TextBox x:Name="AliasInternalBox" materialDesign:HintAssist.Hint="Internal System Name (Optional)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                                    
                                    <Border Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoSoftBorderBrush}" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,4,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource InfoBrush}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="SYSTEM NOTE" FontSize="10" FontWeight="Black" Foreground="{StaticResource InfoBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="Add custom champions or custom spellings. For official Riot names, specify the exact internal system name if it differs (e.g. display Wukong -> internal MonkeyKing)." 
                                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" LineHeight="16"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <Button Content="ADD CHAMPION" Click="AddAlias_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountBoxMultiple" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="ALIASES REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISPLAY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="INT NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding AliasManager.Aliases}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InternalName}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11"/>
                                                <Button Grid.Column="3" Click="DeleteAlias_Click" Style="{StaticResource DangerIconButton}" Width="30" Height="30">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 4: MONSTERS -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Ghost" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="MONSTERS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Ghost" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="14" Height="14"/>
                                    <TextBlock Text="NEW MONSTER" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBox x:Name="NewMonsterBox" materialDesign:HintAssist.Hint="Monster Name (e.g. Zebra)" Style="{StaticResource ModernTextBox}" Margin="0,6,0,24"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <Button Content="ADD MONSTER" Click="AddMonster_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Ghost" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="MONSTERS REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MONSTER NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding MonsterList}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Button Grid.Column="1" Click="DeleteMonster_Click" CommandParameter="{Binding}" Style="{StaticResource DangerIconButton}" Width="30" Height="30">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 5: STRUCTURES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HomeModern" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="STRUCTURES" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HomeModern" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="14" Height="14"/>
                                    <TextBlock Text="NEW STRUCTURE MAPPING" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <TextBox x:Name="NewStructureKeywordBox" materialDesign:HintAssist.Hint="Folder Keyword (e.g. Tower)" Style="{StaticResource ModernTextBox}" Margin="0,6,0,20"/>
                                    
                                    <ComboBox x:Name="NewStructureTargetBox" materialDesign:HintAssist.Hint="Map Target Icon" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,24">
                                        <sys:String>Turret</sys:String>
                                        <sys:String>Inhibitor</sys:String>
                                        <sys:String>Nexus</sys:String>
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <Button Content="ADD STRUCTURE" Click="AddStructure_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HomeModern" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="STRUCTURES REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KEYWORD" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="MAP TARGET ICON" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding StructureList}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TargetName}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <Button Grid.Column="2" Click="DeleteStructure_Click" Style="{StaticResource DangerIconButton}" Width="30" Height="30">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
