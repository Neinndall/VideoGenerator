<Window x:Class="VideoGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:VideoGenerator.Views"
        mc:Ignorable="d"
        Title="VideoGenerator"
        Height="960"
        Width="1480"
        MinHeight="780"
        MinWidth="1200"
        Icon="Resources/logo.ico"
        Background="{StaticResource PrimaryBackgroundBrush}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Application rail: identity, navigation, and system availability remain visible everywhere. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource AppShellSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,20,4,32" HorizontalAlignment="Center">
                    <Border Style="{StaticResource AppShellBrandMark}" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="VideoOutline" Width="24" Height="24"
                                                 Foreground="{StaticResource AccentBrushLight}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VIDEO GENERATOR" Margin="0,14,0,0" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextHighlightBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrushLight}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="WORKSPACES" Style="{StaticResource AppShellNavSectionText}"/>

                <ListBox Grid.Row="2" x:Name="NavListBox"
                          Style="{StaticResource VirtualizedListBoxStyle}"
                          ItemContainerStyle="{StaticResource ModernNavItem}"
                          SelectionChanged="NavListBox_SelectionChanged">
                    <ListBoxItem IsSelected="True" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboardOutline" Margin="0,0,13,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Background">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ImageEditOutline" Margin="0,0,13,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="Visual design" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="EventRules">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cogs" Margin="0,0,13,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="Event mapping" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Translations">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Translate" Margin="0,0,13,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="Dictionary" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SettingsOutline" Margin="0,0,13,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main content area docked seamlessly -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AppShellContent}" Padding="24,20">
            <ContentControl x:Name="ContentArea"/>
        </Border>

        <!-- The activity rail makes task state readable without taking focus away from the workspace. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppShellStatusBar}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="4,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="CheckCircleOutline"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Progress.IsBusy}" Value="True">
                                        <Setter Property="Kind" Value="Sync"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress.StatusText}" Value="CANCELED - TASK ANNULLED">
                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="{StaticResource CancelBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM STATUS" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Progress.StatusText}" ToolTip="{Binding Progress.StatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                    <local:ModernProgressBar Value="{Binding Progress.Value, Mode=OneWay}"
                                             IsIndeterminate="{Binding Progress.IsIndeterminate, Mode=OneWay}"
                                             Visibility="{Binding Progress.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Height="7"/>
                    <TextBlock Text="READY TO PROCESS VIDEOS" HorizontalAlignment="Center" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Progress.IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource StatusPill}" Padding="10,6" Margin="0,0,12,0"
                        Visibility="{Binding Progress.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Progress.Value, StringFormat={}{0:F0}%}" Style="{StaticResource MonoValueText}"/>
                </Border>

                <Button Grid.Column="3" Click="CancelProcessing_Click" Style="{StaticResource ModernCancelButton}" Height="34" Padding="14,0"
                        Visibility="{Binding Progress.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CANCEL" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
