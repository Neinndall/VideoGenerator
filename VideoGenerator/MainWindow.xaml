<Window x:Class="VideoGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:VideoGenerator.Converters"
        xmlns:local="clr-namespace:VideoGenerator.Views"
        mc:Ignorable="d"
        Title="VideoGenerator" 
        Height="800" 
        Width="1250"
        Icon="Resources/logo.ico"
        Background="{StaticResource PrimaryBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Floating Sidebar -->
        <materialDesign:Card Grid.Column="0" 
                             UniformCornerRadius="24"
                             Background="{StaticResource SecondaryBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,40,24,32">
                    <materialDesign:PackIcon Kind="VideoOutline" 
                                             Width="56" 
                                             Height="56" 
                                             Foreground="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16"/>
                    <TextBlock Text="VideoGenerator" 
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                               HorizontalAlignment="Center" 
                               FontWeight="Bold"/>
                    <TextBlock Text="v2.0.0.0" 
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                               HorizontalAlignment="Center" 
                               Opacity="0.3"
                               FontFamily="Consolas"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <ListBox x:Name="NavListBox" 
                             Style="{StaticResource ModernNavigationListBox}"
                             SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem IsSelected="True" Tag="Dashboard"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="ViewDashboard" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Background"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="ImageEdit" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Background Design" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="EventRules"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="Cogs" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Mapping" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Translations"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="Translate" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dictionary &amp; Events" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="Settings" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="History"
                                     Margin="0,2" Height="48" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="History" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="2" 
                        Margin="16,24" 
                        Padding="16" 
                        Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="SYSTEM STATUS" 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                   FontWeight="Bold" 
                                   FontSize="10"
                                   Margin="0,0,0,12"
                                   Opacity="0.5"/>
                        <ProgressBar Value="0" 
                                     IsIndeterminate="False" 
                                     Height="6" 
                                     Margin="0,4"
                                     materialDesign:TransitionAssist.DisableTransitions="True"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource PrimaryBackgroundBrush}"/>
                        <TextBlock Margin="0,8,0,0"
                                   Text="System Ready"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="ContentArea" />
        </ScrollViewer>
    </Grid>
</Window>
