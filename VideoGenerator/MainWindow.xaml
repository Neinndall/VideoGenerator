<Window x:Class="VideoGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:VideoGenerator.Views.Shell"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="VideoGenerator"
        Height="960"
        Width="1480"
        MinHeight="700"
        MinWidth="960"
        Icon="Resources/logo.ico"
        Background="{StaticResource ShellSidebarUniformBrush}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="57"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <shell:SidebarView x:Name="NavigationRail" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                           NavigationRequested="NavigationRail_NavigationRequested"/>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AppShellTopBar}" Padding="24,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SidebarToggleButton" Grid.Column="0"
                        Click="ToggleSidebar_Click" Style="{StaticResource AppShellSidebarToggleButton}"
                        Margin="0,0,22,0"
                        ToolTip="Toggle navigation sidebar (Ctrl+B)"
                        AutomationProperties.Name="Toggle navigation sidebar">
                    <!-- White hamburger glyph; hover and keyboard focus recolor only the bars. -->
                    <StackPanel Width="22" Height="16" IsHitTestVisible="False"
                                VerticalAlignment="Center">
                        <Border Height="2" Width="22" CornerRadius="1"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        <Border Height="2" Width="22" CornerRadius="1" Margin="0,5,0,0"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        <Border Height="2" Width="22" CornerRadius="1" Margin="0,5,0,0"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Medium"
                               Foreground="#A9BFF1" VerticalAlignment="Center" Margin="0,0,17,0"/>
                    <Border Width="1" Height="23" Background="{StaticResource ShellTopBarLabelDividerBrush}" Margin="0,0,17,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActiveWorkspaceTitle" Text="Production studio"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextHighlightBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Live production counters share the persistent top bar, freeing
                     vertical space in every workspace. This panel is bound to the
                     cached dashboard model in MainWindow.NavigateTo. -->
                <StackPanel x:Name="WorkspaceCounters" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource AppShellTopMetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="EVENTS" Style="{StaticResource AppShellTopMetricLabel}"/>
                            <TextBlock Text="{Binding VisibleEventCount}" Style="{StaticResource AppShellTopMetricValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="17" Background="{StaticResource ShellTopBarMetricDividerBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource AppShellTopMetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SELECTED" Style="{StaticResource AppShellTopMetricLabel}"/>
                            <TextBlock Text="{Binding SelectedVisibleEventCount}" Style="{StaticResource AppShellTopMetricValue}"/>
                            <TextBlock Text="/" Style="{StaticResource AppShellTopMetricSeparator}"/>
                            <TextBlock Text="{Binding VisibleEventCount}" Style="{StaticResource AppShellTopMetricValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="17" Background="{StaticResource ShellTopBarMetricDividerBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource AppShellTopMetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MAPPING" Style="{StaticResource AppShellTopMetricLabel}"/>
                            <TextBlock Text="{Binding NeedsMappingVisibleEventCount}"
                                       Style="{StaticResource AppShellTopMetricValue}"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="17" Background="{StaticResource ShellTopBarMetricDividerBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource AppShellTopMetricPill}" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ELIGIBLE" Style="{StaticResource AppShellTopMetricLabel}"/>
                            <TextBlock Text="{Binding RunnableSelectedVisibleEventCount}"
                                       Style="{StaticResource AppShellTopMetricValue}"
                                       Foreground="{StaticResource AccentBrushLight}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WorkspaceContentSurface" Grid.Row="1" Grid.Column="1" Style="{StaticResource AppShellContent}" Padding="24,20">
            <ContentControl x:Name="ContentArea"/>
        </Border>

        <shell:GlobalStatusBar x:Name="SystemStatusRail" Grid.Row="2" Grid.Column="1" CancelRequested="GlobalStatusBar_CancelRequested"/>
    </Grid>
</Window>
