<Window x:Class="VideoGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
        xmlns:local="clr-namespace:VideoGenerator.Views"
        mc:Ignorable="d"
        Title="VideoGenerator" 
        Height="950" 
        Width="1400"
        MinHeight="780"
        MinWidth="1200"
        Icon="Resources/logo.ico"
        Background="{StaticResource PrimaryBackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Global Footer Status Bar -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Modern Sidebar -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                Style="{StaticResource ModernContainer}"
                Margin="16,24,8,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="8,32,8,24">
                    <Border Width="64" Height="64" 
                            Background="#1A8B5CF6" 
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="VideoOutline" 
                                                 Width="32" 
                                                 Height="32" 
                                                 Foreground="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VIDEO GENERATOR" 
                               FontSize="15"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" 
                               Opacity="0.7"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <ListBox x:Name="NavListBox" 
                             Style="{StaticResource VirtualizedListBoxStyle}"
                             ItemContainerStyle="{StaticResource ModernNavItem}"
                             SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem IsSelected="True" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Background">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageEditOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Visual Design" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="EventRules">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Mapping" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Translations">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dictionary" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SettingsOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="0" Grid.Column="1" 
                Background="{StaticResource PrimaryBackgroundBrush}"
                BorderThickness="0"
                Margin="8,24,16,2">
            <ContentControl x:Name="ContentArea" Margin="0" />
        </Border>

        <!-- Global Status & Progress Footer -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,6"
                Height="40"
                Margin="8,2,16,16"
                VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/> <!-- Status Icon & Text Group (Fixed to prevent shifting) -->
                    <ColumnDefinition Width="*"/>    <!-- Progress Bar -->
                    <ColumnDefinition Width="Auto"/> <!-- Progress Percentage -->
                    <ColumnDefinition Width="Auto"/> <!-- Cancel Button -->
                </Grid.ColumnDefinitions>
                
                <!-- Left: Status Icon and Label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <!-- Status Icon -->
                    <materialDesign:PackIcon x:Name="StatusIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="CheckCircleOutline"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEngineBusy}" Value="True">
                                        <Setter Property="Kind" Value="Sync"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStatusText}" Value="CANCELED - TASK ANNULLED">
                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="{StaticResource CancelBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <!-- Status Label -->
                    <TextBlock Text="{Binding EngineStatusText}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEngineBusy}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStatusText}" Value="CANCELED - TASK ANNULLED">
                                        <Setter Property="Foreground" Value="{StaticResource CancelBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Middle: Modern Progress Bar -->
                <local:ModernProgressBar Grid.Column="1" 
                                         Value="{Binding EngineProgressBarValue, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsEngineIndeterminate, Mode=OneWay}"
                                         Visibility="{Binding IsEngineBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         VerticalAlignment="Center"
                                         Height="6"
                                         Margin="0,0,16,0"/>

                <!-- Right: Progress Percentage Text -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding EngineProgressBarValue, StringFormat={}{0:F1}%}"
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource AccentBrushLight}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Visibility="{Binding IsEngineBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Far Right: Cancel Button -->
                <Button Grid.Column="3" 
                        Click="CancelProcessing_Click"
                        Style="{StaticResource ModernCancelButton}"
                        Height="28" Padding="12,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEngineBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CANCEL (ESC)" FontSize="9" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
