<Window x:Class="VideoGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
        xmlns:local="clr-namespace:VideoGenerator.Views"
        mc:Ignorable="d"
        Title="VideoGenerator" 
        Height="800" 
        Width="1250"
        Icon="Resources/logo.ico"
        Background="{StaticResource PrimaryBackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Modern Sidebar -->
        <Border Grid.Column="0" 
                Style="{StaticResource ModernContainer}"
                Margin="8"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="24,40,24,32">
                    <Border Width="64" Height="64" 
                            Background="#1A8B5CF6" 
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="VideoOutline" 
                                                 Width="32" 
                                                 Height="32" 
                                                 Foreground="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VIDEO GENERATOR" 
                               FontSize="18"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" 
                               Opacity="0.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <ListBox x:Name="NavListBox" 
                             Style="{StaticResource VirtualizedListBoxStyle}"
                             ItemContainerStyle="{StaticResource ModernNavItem}"
                             SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem IsSelected="True" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Background">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageEditOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Background Design" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="EventRules">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Mapping" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Translations">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dictionary" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SettingsOutline" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- Status Info Footer -->
                <Border Grid.Row="2" 
                        Margin="16,24" 
                        Padding="16" 
                        Style="{StaticResource HUDBorder}">
                    <StackPanel>
                        <TextBlock Text="ENGINE STATUS" 
                                   FontSize="10"
                                   FontWeight="Black"
                                   Margin="0,0,0,8"
                                   Opacity="0.4"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Grid>
                            <ProgressBar Value="100" 
                                         Height="4" 
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource PrimaryBackgroundBrush}"/>
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="STABLE - READY"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" 
                Margin="8"
                Background="{StaticResource PrimaryBackgroundBrush}"
                CornerRadius="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <ContentControl x:Name="ContentArea" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
