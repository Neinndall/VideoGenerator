<Window x:Class="VideoGenerator.Views.DialogueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:services="clr-namespace:VideoGenerator.Services"
        xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
        mc:Ignorable="d"
        Title="Dialogue Editor" 
        Height="700" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0F"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NonLockingImageConverter x:Key="NonLockingImageConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Workspace -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="250" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Left Panel: Pipeline List -->
            <Border Grid.Column="0" Background="#121214" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="EVENTS QUEUE" FontWeight="Black" Foreground="{StaticResource TextHighlightBrush}" FontSize="12"/>
                            <TextBlock Text="Select an event to edit segments" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ListBox of Events -->
                    <ListBox x:Name="EventsListBox" Grid.Row="1"
                             Style="{StaticResource VirtualizedListBoxStyle}"
                             SelectionChanged="EventsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CharacterName}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Validation Indicator -->
                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <materialDesign:PackIcon x:Name="CheckIcon" Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel: Audio Segment Editor -->
            <Grid Grid.Column="2" Margin="24,20,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Event Details Header -->
                <Border Grid.Row="0" Style="{StaticResource ModernContainer}" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Resolved Icon -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#1A1A1D" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,16,0">
                            <Image Source="{Binding SelectedEvent.ParsedData.IconPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NonLockingImageConverter}}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedEvent.FolderName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Black" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedEvent.ParsedData.DisplayText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedEvent.CharacterName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Audio Parts ItemsControl -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl x:Name="PartsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernContainer}" Background="#141416" Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Play Button -->
                                            <ColumnDefinition Width="*"/>    <!-- Text Editor -->
                                            <ColumnDefinition Width="Auto"/> <!-- Validated Checkbox -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Play/Pause Control -->
                                        <Button Grid.Column="0" Click="PlayPartAudio_Click" 
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                Background="#1C1C20" Foreground="{StaticResource AccentBrush}" 
                                                Width="44" Height="44" Margin="0,0,16,0"
                                                ToolTip="Play/Stop this audio segment">
                                            <materialDesign:PackIcon Kind="Play" Width="22" Height="22" x:Name="PlayIcon"/>
                                        </Button>

                                        <!-- Subtitle Edit Box -->
                                        <TextBox Grid.Column="1" Text="{Binding Dialogue, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Dialogue Transcript (Segment)"
                                                 Style="{StaticResource CompactModernTextBox}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Height="60" VerticalContentAlignment="Top" Padding="12,8"/>

                                        <!-- Validated Toggle -->
                                        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="VALIDATE" FontSize="8" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <CheckBox IsChecked="{Binding IsValidated, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignCheckBox}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Editor Action Buttons -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="TranscribeCurrentEvent_Click"
                            Style="{StaticResource ModernPrimaryButton}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                            Height="44" Padding="16,0"
                            IsEnabled="{Binding Source={x:Static services:AppSettings.Instance}, Path=EnableTranscriptions}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Microphone" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="AUTO-TRANSCRIBE WHISPER" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="ApplyEventChanges_Click"
                            Style="{StaticResource ModernPrimaryButton}"
                            Height="44" Padding="24,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="SAVE &amp; APPLY CHANGES" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Window Bar -->
        <Border Grid.Row="1" Background="#0A0A0C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Verify transcripts, edit errors, and press Approve once complete." 
                           VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>

                <Button Grid.Column="1" Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource TextSecondaryBrush}"
                        Height="44" Padding="16,0" Margin="0,0,12,0">
                    <TextBlock Text="CANCEL" FontSize="11" FontWeight="Black"/>
                </Button>

                <Button Grid.Column="2" Click="Done_Click"
                        Style="{StaticResource ModernPrimaryButton}"
                        Height="44" Padding="24,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="APPROVE BATCH &amp; CLOSE" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
