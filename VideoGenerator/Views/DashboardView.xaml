<UserControl x:Class="VideoGenerator.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
             xmlns:services="clr-namespace:VideoGenerator.Services"
             xmlns:utils="clr-namespace:VideoGenerator.Utils">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NonLockingImageConverter x:Key="NonLockingImageConverter"/>
        <Style x:Key="DashboardEventSelectionCheckBox"
               TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="SelectionBox" Width="18" Height="18" CornerRadius="4"
                                    Background="#0B1933" BorderBrush="#375B87"
                                    BorderThickness="1" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionTick" Text="✓" Visibility="Collapsed"
                                           Foreground="{StaticResource AccentBrushLight}"
                                           FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBox" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{StaticResource AccentBrushLight}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardPipelineFilter" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Same single underline language as the HUD ALIGNMENT selector.
                             The line is always allocated so selecting never shifts content. -->
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" ContentSource="Content"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Border x:Name="SelectionLine" Grid.Row="1" Height="2"
                                    Background="{StaticResource AccentBrushLight}"
                                    CornerRadius="1" Opacity="0" Margin="7,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                                <Setter TargetName="SelectionLine" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                                <Setter TargetName="SelectionLine" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionLine" Property="Opacity" Value="1"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardPipelineRow" TargetType="ListBoxItem">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The outline is always one pixel wide: selection, mouse
                             hover and keyboard focus never change row geometry. -->
                        <Border x:Name="RowSurface" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="RowAccent" Width="3" Background="Transparent"
                                        HorizontalAlignment="Left" Margin="0,7,0,7" CornerRadius="2"/>
                                <ContentPresenter Margin="7,0,5,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#112B4B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#163F69"/>
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="#367EC2"/>
                                <Setter TargetName="RowAccent" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource WorkspacePagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ConfigRow" Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition x:Name="LogsRow" Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder controls start immediately below the persistent app toolbar. -->
        <Grid x:Name="AnalysisToolbar" Grid.Row="0" Margin="0,0,0,12"
              SizeChanged="AnalysisToolbar_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AnalysisFiltersPanel" Style="{StaticResource WorkspaceToolbarContainer}"
                    Margin="0,0,16,0">
                <Grid x:Name="AnalysisFiltersGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- Path Selector -->
                        <ColumnDefinition Width="Auto"/> <!-- Search Box (Hidden until processed) -->
                        <ColumnDefinition Width="Auto"/> <!-- Character filter (Hidden until processed) -->
                    </Grid.ColumnDefinitions>

                    <!-- Path Selector -->
                    <StackPanel x:Name="AnalysisPathSelector" Grid.Column="0"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DashboardModel.AudioPath}"
                                     materialDesign:HintAssist.Hint="Media Source Directory"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Click="SelectFolder_Click" Style="{StaticResource IconActionButton}" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Search Box (Only visible after analysis is complete) -->
                    <StackPanel x:Name="AnalysisSearchSelector" Grid.Column="1" Width="180"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding DashboardModel.IsAnalyzed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding DashboardModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search Event..."
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource CompactModernTextBox}" 
                                     Height="42"
                                     Padding="10,4,26,4"/>
                            
                            <Button Style="{StaticResource IconActionButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                    Width="24" Height="24" Click="ClearSearch_Click"
                                    Visibility="{Binding DashboardModel.SearchQuery, Converter={StaticResource NullToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Character Selector (Only visible after analysis is complete) -->
                    <StackPanel x:Name="AnalysisCharacterSelector" Grid.Column="2" Width="160"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding DashboardModel.IsAnalyzed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox ItemsSource="{Binding DashboardModel.CharactersList}" 
                                  SelectedItem="{Binding DashboardModel.SelectedCharacter}"
                                  materialDesign:HintAssist.Hint="Filter Character"
                                  Style="{StaticResource ModernComboBoxStyle}" Height="42" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="AnalysisActionsPanel" Grid.Column="1"
                        Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,3,0,3">
                <Button Click="ExportManifest_Click"
                        IsEnabled="{Binding DashboardModel.IsAnalyzed}"
                        Style="{StaticResource ModernSecondaryButton}"
                        Height="42" Padding="12,0" Margin="0,0,10,0"
                        ToolTip="Export the analyzed event names and mapping results without audio or transcripts">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ExportVariant" Margin="0,0,7,0" VerticalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="EXPORT MANIFEST" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Click="ProcessFolders_Click"
                        IsEnabled="{Binding DashboardModel.IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Width="172" Height="42"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileSearchOutline" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="1. SCAN FOLDERS" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN WORKSPACE: LIST & PREVIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PipelineColumn" Width="430" MinWidth="250" MaxWidth="700"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DETECTED EVENTS LIST -->
            <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource WorkspacePanelHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PlaylistPlay" Foreground="{StaticResource TextMutedBrush}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="DETECTED PIPELINE" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="RetryMissingIcons_Click"
                                        IsEnabled="{Binding DashboardModel.IsAnalyzed}"
                                        Style="{StaticResource AccentActionButton}" Padding="6,2" Margin="0,0,8,0"
                                        AutomationProperties.Name="Retry missing event icons"
                                        ToolTip="Retry missing event images without scanning folders again">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageRefreshOutline" Width="13" Height="13" Margin="0,0,5,0"/>
                                        <TextBlock Text="RETRY ICONS" VerticalAlignment="Center" FontSize="8"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SelectAllVisible_Click"
                                        IsEnabled="{Binding DashboardModel.HasVisibleEvents}"
                                        Style="{StaticResource AccentActionButton}"
                                        Padding="6,2"
                                        ToolTip="Toggle selection for all events currently visible in the list">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckboxMultipleMarkedOutline" Width="13" Height="13" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding DashboardModel.SelectionActionLabel}" VerticalAlignment="Center" FontSize="8"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filter pills -->
                    <Border Grid.Row="1" Background="#0C1E3B" Padding="10,8,10,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="ALL" GroupName="FilterGroup" IsChecked="{Binding DashboardModel.SelectedFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ALL, Mode=TwoWay}" Checked="Filter_Checked" Tag="ALL" Style="{StaticResource DashboardPipelineFilter}"/>
                            <RadioButton Grid.Column="1" Content="ERRORS" GroupName="FilterGroup" IsChecked="{Binding DashboardModel.SelectedFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ERRORS, Mode=TwoWay}" Checked="Filter_Checked" Tag="ERRORS" Style="{StaticResource DashboardPipelineFilter}"/>
                            <RadioButton Grid.Column="2" Content="PENDING" GroupName="FilterGroup" IsChecked="{Binding DashboardModel.SelectedFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=PENDING, Mode=TwoWay}" Checked="Filter_Checked" Tag="PENDING" Style="{StaticResource DashboardPipelineFilter}"/>
                            <RadioButton Grid.Column="3" Content="MAPPING" GroupName="FilterGroup" IsChecked="{Binding DashboardModel.SelectedFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=NEEDS_MAPPING, Mode=TwoWay}" Checked="Filter_Checked" Tag="NEEDS_MAPPING" Style="{StaticResource DashboardPipelineFilter}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" 
                              x:Name="EventsListBox"
                              Background="#09192F"
                              ItemsSource="{Binding DashboardModel.FilteredProcessedEvents}"
                              SelectedItem="{Binding DashboardModel.SelectedEvent}"
                              SelectionChanged="EventsListBox_SelectionChanged"
                              Style="{StaticResource VirtualizedListBoxStyle}"
                              ItemContainerStyle="{StaticResource DashboardPipelineRow}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              utils:ScrollHelper.BubbleMouseWheel="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,3,2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource DashboardEventSelectionCheckBox}"/>
                                        
                                        <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                                <Run Text="{Binding ParsedData.DisplayText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <Run Text=" • " Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding CharacterName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border x:Name="StatusBadge" Grid.Column="2" CornerRadius="5"
                                                Width="92" Height="23" Padding="3,2" VerticalAlignment="Center"
                                                Background="#132138" BorderBrush="Transparent" BorderThickness="1">
                                            <TextBlock x:Name="StatusText" FontSize="8" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <Button x:Name="CreateRuleButton"
                                                Grid.Column="3"
                                                Click="CreateRule_Click"
                                                Visibility="Hidden"
                                                Style="{StaticResource AccentActionButton}"
                                                Width="28"
                                                Height="28"
                                                Padding="4,3"
                                                Margin="6,0,0,0"
                                                ToolTip="Open the rule editor with this unmapped event pre-filled">
                                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="15" Height="15"/>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="4"
                                                Click="DeleteEvent_Click"
                                                Style="{StaticResource DangerIconButton}"
                                                Width="28" Height="28"
                                                Margin="4,0,0,0"
                                                ToolTip="Remove event from pipeline">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource SuccessPillBgBrush}"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource SuccessPillBorderBrush}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="READY"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Needs Mapping">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource WarningPillBgBrush}"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource WarningPillBorderBrush}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="NEEDS MAPPING"/>
                                        <Setter TargetName="CreateRuleButton" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing Icon">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource WarningPillBgBrush}"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource WarningPillBorderBrush}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="MISSING ICON"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="No Audio">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource ErrorPillBgBrush}"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource ErrorPillBorderBrush}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="NO AUDIO"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" IsHitTestVisible="False" Background="Transparent" Padding="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DashboardModel.HasVisibleEvents}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="290">
                            <materialDesign:PackIcon Kind="FileSearchOutline" Width="40" Height="40"
                                                     HorizontalAlignment="Center" Foreground="{StaticResource AccentBrushLight}" Opacity="0.75"/>
                            <TextBlock Text="No events to show" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Choose a source folder and scan it, or adjust your active filters."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Resizable Splitter -->
            <GridSplitter Grid.Column="1" 
                          Width="12" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="Transparent" 
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <!-- RIGHT: LIVE RENDERING PREVIEW & QUICK EDIT -->
            <Grid x:Name="PreviewContainerGrid" Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="QuickEditRow" Height="Auto"/>
                    <RowDefinition x:Name="ProgressRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource WorkspaceCanvasContainer}">
                    <Grid>
                        <Viewbox Stretch="Uniform" VerticalAlignment="Center" Margin="24">
                            <Grid Width="1920" Height="1080" Background="{StaticResource PrimaryBackgroundBrush}">
                                <Image Source="{Binding DashboardModel.PreviewImageSource}" 
                                       Stretch="Uniform" 
                                       UseLayoutRounding="True"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Cursor="Hand"
                                       MouseDown="PreviewImage_MouseDown"
                                       ToolTip="Click to toggle maximize mode (hides/shows event pipeline sidebar)"/>
                                
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                                             Visibility="{Binding DashboardModel.PreviewImageSource, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                    <materialDesign:PackIcon Kind="ImageSearchOutline" Width="120" Height="120" HorizontalAlignment="Center" Opacity="0.1" Foreground="White"/>
                                    <TextBlock Text="SELECT AN EVENT TO PREVIEW" FontWeight="Black" FontSize="32" Opacity="0.1" Foreground="White" Margin="0,24,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <Border Background="#CC161618" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="12,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TelevisionPlay" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE RENDER PREVIEW" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextHighlightBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- QUICK EDIT PANEL (Collapsible, shown when an event is selected) -->
                <Border Grid.Row="1" Style="{StaticResource WorkspaceInspectorContainer}"
                        Visibility="{Binding DashboardModel.SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Row 0: Text Input & Apply Button -->
                        <TextBox x:Name="QuickEditDisplayText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                  Text="{Binding DashboardModel.SelectedEvent.ParsedData.DisplayText, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Text shown in HUD"
                                  ToolTip="Text that appears on the generated image/video"
                                  Style="{StaticResource CompactModernTextBox}"
                                  Margin="0,0,12,12"/>

                        <Button Grid.Row="0" Grid.Column="2" Click="ApplyQuickEdit_Click"
                                Style="{StaticResource ModernPrimaryButton}"
                                Height="40" Padding="16,0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ContentSaveOutline" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Grid.Column="1" Text="APPLY CHANGES" VerticalAlignment="Center" FontSize="11" FontWeight="Black" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>

                        <!-- Row 1: Icon configuration (Lookup and Type) -->
                        <TextBox x:Name="QuickEditIconLookup" Grid.Row="1" Grid.Column="0"
                                  Text="{Binding DashboardModel.SelectedEvent.ParsedData.IconLookupName, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Icon name or ID"
                                  ToolTip="For items you can type a fragment like 'Infinity' and it resolves to the official ID"
                                  Margin="0,0,12,12">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CompactModernTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=QuickEditIconType}" Value="generic">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ComboBox x:Name="QuickEditIconType" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                  SelectedValue="{Binding DashboardModel.SelectedEvent.ParsedData.IconType, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Icon category"
                                  ToolTip="Select the type of icon to look up"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Height="40" Margin="0,0,0,12">
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">champion</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">skinline</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">item</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">monster</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">structure</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">region</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">system</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">generic</System:String>
                        </ComboBox>

                        <!-- Row 2: Dialogue Subtitle & Test Transcribe -->
                        <TextBox x:Name="QuickEditDialogue" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Text="{Binding DashboardModel.SelectedEvent.Dialogue, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Dialogue Subtitle (Optional, burned into video)"
                                  IsEnabled="{Binding Source={x:Static services:AppSettings.Instance}, Path=EnableTranscriptions}"
                                  ToolTip="Type the spoken voiceover dialogue or click Test Transcribe to use Whisper"
                                  Style="{StaticResource CompactModernTextBox}" Margin="0,0,12,0"/>

                        <Button Grid.Row="2" Grid.Column="2" Click="Transcribe_Click"
                                IsEnabled="{Binding Source={x:Static services:AppSettings.Instance}, Path=EnableTranscriptions}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Height="40" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Microphone" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Grid.Column="1" Text="TEST TRANSCRIBE" VerticalAlignment="Center" FontSize="11" FontWeight="Black" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- FINAL ACTIONS GRID -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Click="PrepareTranscription_Click"
                            IsEnabled="{Binding DashboardModel.CanRunWorkflow}"
                            Style="{StaticResource WorkflowStepButton}"
                            Background="{StaticResource SurfaceBrush}"
                            Padding="10,0"
                            Height="44" Margin="0,0,6,0"
                            ToolTip="Run Whisper speech-to-text transcription to generate subtitles for audio files">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="MicrophoneOutline" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="2. PREPARE DIALOGUES" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Button>

                    <!-- Review Dialogues (Dialogue Editor) -->
                    <Button Grid.Column="1" 
                            Click="ReviewDialogues_Click"
                            IsEnabled="{Binding DashboardModel.CanRunWorkflow}"
                            Style="{StaticResource WorkflowStepButton}"
                            Background="{StaticResource SurfaceBrush}"
                            Padding="10,0"
                            Height="44" Margin="6,0,6,0"
                            ToolTip="Open Dialogue Segment Editor to review and correct transcripts">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="PlaylistEdit" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="3. REVIEW" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Button>

                    <!-- Render Videos -->
                    <Button Grid.Column="2" 
                            Click="Generate_Click"
                            IsEnabled="{Binding DashboardModel.CanRunWorkflow}"
                            Style="{StaticResource WorkflowPrimaryStepButton}"
                            Padding="10,0"
                            Height="44" Margin="6,0,0,0"
                            ToolTip="Generate and lossless compile final .mp4 videos using FFmpeg">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="4. RENDER VIDEOS" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. TERMINAL LOGS (COMPACT) -->
        <Border Grid.Row="2" Style="{StaticResource ConsolePanelContainer}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Both content surfaces live INSIDE the single rounded frame.
                     The parent panel clips this Grid; no inset second outline. -->
                <Border Background="#10233F" Padding="16,8" CornerRadius="12,12,0,0"
                        BorderBrush="#254362" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Terminal" Foreground="{StaticResource TextMutedBrush}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ENGINE CONSOLE" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                <RichTextBox Grid.Row="1" 
                             services:LogExtensions.RichLogSource="{Binding LogService.Logs}"
                             FontSize="10" Padding="6">
                    <RichTextBox.Style>
                        <Style TargetType="RichTextBox" BasedOn="{StaticResource ModernRichTextBox}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RichTextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                          Focusable="false" 
                                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" 
                                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RichTextBox.Style>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
