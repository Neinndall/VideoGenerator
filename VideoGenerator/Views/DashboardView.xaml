<UserControl x:Class="VideoGenerator.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
             xmlns:services="clr-namespace:VideoGenerator.Services"
             xmlns:utils="clr-namespace:VideoGenerator.Utils">
    
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NonLockingImageConverter x:Key="NonLockingImageConverter"/>
    </UserControl.Resources>

    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. CINEMATIC HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="PRODUCTION DASHBOARD" 
                       FontSize="28" 
                       FontWeight="Black" 
                       Foreground="{StaticResource TextHighlightBrush}" />
            <TextBlock Text="Analyze media assets, validate event mapping, and execute batch video rendering." 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       Opacity="0.7" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. CONFIGURATION & ANALYSIS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ModernContainer}" Margin="0,0,16,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Path Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DashboardModel.AudioPath}"
                                     materialDesign:HintAssist.Hint="Media Source Directory"
                                     Style="{StaticResource CompactModernTextBox}"
                                     IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Click="SelectFolder_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource AccentBrush}" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Lang -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <ComboBox ItemsSource="{Binding DashboardModel.AvailableLanguages}" 
                                  SelectedItem="{Binding DashboardModel.SelectedLanguage}"
                                  materialDesign:HintAssist.Hint="Target Lang"
                                  Style="{StaticResource ModernComboBoxStyle}" Height="42" Padding="12,0"/>
                    </StackPanel>

                    <!-- Font -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <ComboBox ItemsSource="{Binding DashboardModel.FontNames}" 
                                  SelectedItem="{Binding DashboardModel.SelectedFontName}"
                                  materialDesign:HintAssist.Hint="HUD Typography"
                                  Style="{StaticResource ModernComboBoxStyle}" Height="42" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Column="1" 
                    Click="ProcessFolders_Click"
                    IsEnabled="{Binding DashboardModel.IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource ModernPrimaryButton}"
                    Width="200" Height="74">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileSearchOutline" Margin="0,0,12,0" VerticalAlignment="Center" Width="20" Height="20"/>
                    <TextBlock Text="PROCESS FOLDERS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. MAIN WORKSPACE: LIST & PREVIEW -->
        <Grid Grid.Row="2" Height="500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DETECTED EVENTS LIST -->
            <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Padding="0" Margin="0,0,24,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="DETECTED PIPELINE" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DashboardModel.ProcessedEvents.Count, StringFormat='{}COUNT: {0}'}" 
                                       HorizontalAlignment="Right" FontSize="9" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding DashboardModel.ProcessedEvents}"
                             SelectedItem="{Binding DashboardModel.SelectedEvent}"
                             Style="{StaticResource VirtualizedListBoxStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             utils:ScrollHelper.BubbleMouseWheel="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ParsedData.DisplayText}" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding CharacterName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border x:Name="StatusBadge" Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusText" FontSize="8" FontWeight="Black"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1A10B981"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#8010B981"/>
                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="READY"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing Icon">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1AF59E0B"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#80F59E0B"/>
                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="MISSING ICON"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="No Audio">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1AEF4444"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#80EF4444"/>
                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="NO AUDIO"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernNavItem}">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Height" Value="Auto"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: LIVE RENDERING PREVIEW -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModernContainer}" Padding="0" Background="#050505" ClipToBounds="True">
                    <Grid>
                        <!-- Technician Grid Background -->
                        <Border Opacity="0.03" IsHitTestVisible="False">
                            <Border.Background>
                                <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Grid Width="40" Height="40">
                                            <Path Data="M 40 0 L 0 0 0 40" Stroke="White" StrokeThickness="1"/>
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.Background>
                        </Border>

                        <Viewbox Stretch="Uniform" VerticalAlignment="Center" Margin="24">
                            <Grid Width="1920" Height="1080" Background="#0D0D0F">
                                <Image Source="{Binding DashboardModel.PreviewImagePath, Converter={StaticResource NonLockingImageConverter}}" Stretch="UniformToFill"/>
                                
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                                            Visibility="{Binding DashboardModel.PreviewImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                    <materialDesign:PackIcon Kind="ImageSearchOutline" Width="120" Height="120" HorizontalAlignment="Center" Opacity="0.1" Foreground="White"/>
                                    <TextBlock Text="SELECT AN EVENT TO PREVIEW" FontWeight="Black" FontSize="32" Opacity="0.1" Foreground="White" Margin="0,24,0,0"/>
                                </StackPanel>

                                <Border BorderBrush="White" BorderThickness="1" Opacity="0.2"/>
                            </Grid>
                        </Viewbox>

                        <Border Background="#CC161618" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="12,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TelevisionPlay" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE RENDER PREVIEW" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextHighlightBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- FINAL ACTION -->
                <Button Grid.Row="1" 
                        Click="Generate_Click"
                        IsEnabled="{Binding DashboardModel.IsAnalyzed}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Height="70" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Margin="0,0,16,0" VerticalAlignment="Center" Width="28" Height="28"/>
                        <TextBlock Text="START BATCH RENDERING" VerticalAlignment="Center" FontSize="16" FontWeight="Black"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 4. TERMINAL LOGS (COMPACT) -->
        <Border Grid.Row="3" Style="{StaticResource ModernContainer}" Height="120" Margin="0,24,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" Padding="16,8" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Terminal" Foreground="{StaticResource TextMutedBrush}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ENGINE CONSOLE" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                <RichTextBox Grid.Row="1" 
                             Style="{StaticResource ModernRichTextBox}"
                             services:LogExtensions.RichLogSource="{Binding LogService.Logs}"
                             FontSize="10" Padding="12"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
