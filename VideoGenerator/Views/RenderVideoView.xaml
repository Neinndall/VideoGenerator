<UserControl x:Class="VideoGenerator.Views.RenderVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             Loaded="Editor_Loaded" Unloaded="Editor_Unloaded">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="EditorToolButton" TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="EditorInput" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{StaticResource WorkspacePagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="255"/>
        </Grid.RowDefinitions>

        <!-- Project toolbar: the edit is non-destructive; source MP4s remain untouched. -->
        <Border Grid.Row="0" Style="{StaticResource WorkspacePanelContainer}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="MovieOpenPlayOutline" Foreground="{StaticResource AccentBrushLight}"
                                                 Width="20" Height="20" Margin="0,0,12,0"/>
                        <TextBlock Text="RENDER VIDEO" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="  /  TIMELINE STUDIO" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ProjectStatusText" Text="Untitled project · Import finished clips to begin"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="32,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="NEW" Click="NewProject_Click" Style="{StaticResource EditorToolButton}"/>
                    <Button Content="OPEN" Click="OpenProject_Click" Style="{StaticResource EditorToolButton}"/>
                    <Button Content="SAVE PROJECT" Click="SaveProject_Click" Style="{StaticResource EditorToolButton}"/>
                    <Button x:Name="ExportButton" Content="EXPORT VIDEO" Click="Export_Click"
                            Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="18,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" MinWidth="190"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="230"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="230" MinWidth="195"/>
            </Grid.ColumnDefinitions>
            <!-- Import bin -->
            <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                        <TextBlock Text="MEDIA LIBRARY" Style="{StaticResource EditorLabel}"/>
                        <TextBlock Text="MP4 clips generated by VideoGenerator or imported externally"
                                   TextWrapping="Wrap" FontSize="10" Margin="0,5,0,9"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <WrapPanel>
                            <Button Content="IMPORT" Click="Import_Click" Style="{StaticResource EditorToolButton}" />
                            <Button Content="SCAN GENERATED" Click="ScanGenerated_Click" Style="{StaticResource EditorToolButton}" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="LibraryCountText" Margin="14,6,14,12"
                               Text="0 clips" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <ListBox x:Name="MediaLibraryList" ItemsSource="{Binding Library}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="MediaLibrary_DoubleClick"
                             AutomationProperties.Name="Source video library">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Filmstrip" Width="18" Height="18"
                                                                 Foreground="{StaticResource AccentBrushLight}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Playback of real source MP4s; the current clip trim and next clip are observed. -->
            <Border Grid.Column="2" Style="{StaticResource WorkspacePanelContainer}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="PROGRAM MONITOR" Style="{StaticResource EditorLabel}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="MonitorTitle" Text="No clip selected" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="10"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource WorkspaceContentWellBrush}" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="VideoMonitor" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          Stretch="Uniform" ScrubbingEnabled="True"
                                          MediaOpened="VideoMonitor_MediaOpened" MediaEnded="VideoMonitor_MediaEnded"
                                          MediaFailed="VideoMonitor_MediaFailed"/>
                            <TextBlock x:Name="PreviewEmptyText" Text="Select a timeline clip to preview"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#849CBF" FontSize="12"/>
                        </Grid>
                    </Border>
                    <Slider Grid.Row="2" x:Name="PlayheadSlider" Minimum="0" Maximum="1" Value="0"
                            Margin="2,10,2,4" ValueChanged="PlayheadSlider_ValueChanged"
                            AutomationProperties.Name="Timeline position"/>
                    <Grid Grid.Row="3" Margin="2,1,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="◀" Click="Previous_Click" Style="{StaticResource EditorToolButton}" ToolTip="Previous clip"/>
                        <Button Grid.Column="1" x:Name="PlayPauseButton" Content="PLAY" Click="PlayPause_Click"
                                Style="{StaticResource EditorToolButton}"/>
                        <Button Grid.Column="2" Content="▶" Click="Next_Click" Style="{StaticResource EditorToolButton}" ToolTip="Next clip"/>
                        <TextBlock Grid.Column="3" x:Name="MonitorTimeText" Text="00:00 / 00:00"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <!-- Inspection -->
            <Border Grid.Column="4" Style="{StaticResource WorkspacePanelContainer}" Padding="13,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CLIP INSPECTOR" Style="{StaticResource EditorLabel}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SelectedClipText" Text="Select a clip below" FontWeight="SemiBold"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                        <TextBlock Text="IN POINT (SECONDS)" Style="{StaticResource EditorLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TrimStartBox" Style="{StaticResource EditorInput}" Text="0" Margin="0,0,0,10"/>
                        <TextBlock Text="CLIP LENGTH (SECONDS)" Style="{StaticResource EditorLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ClipDurationBox" Style="{StaticResource EditorInput}" Text="0" Margin="0,0,0,10"/>
                        <Button Content="APPLY TRIM" Click="ApplyTrim_Click" Style="{StaticResource EditorToolButton}"
                                Margin="0,0,0,16"/>
                        <TextBlock Text="EXPORT PRESET" Style="{StaticResource EditorLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="QualityPresetBox" Height="35" DisplayMemberPath="Name"
                                  SelectionChanged="QualityPresetBox_SelectionChanged"
                                  Margin="0,0,0,12"/>
                        <TextBlock x:Name="PresetDetailText" Text="H.264 + AAC · MP4"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="BACKGROUND MUSIC" Style="{StaticResource EditorLabel}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="MusicFileText" Text="No music selected" FontSize="10"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="CHOOSE" Click="ChooseMusic_Click" Style="{StaticResource EditorToolButton}"/>
                            <Button Content="CLEAR" Click="ClearMusic_Click" Style="{StaticResource EditorToolButton}"/>
                        </WrapPanel>
                        <TextBlock Text="MUSIC VOLUME" Style="{StaticResource EditorLabel}" Margin="0,12,0,4"/>
                        <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="1" Value="0.24"
                                SmallChange="0.05" ValueChanged="MusicVolumeSlider_ValueChanged"/>
                        <TextBlock Text="Music is mixed in the exported file; source preview plays clip audio only."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Storyboard timeline -->
        <Border Grid.Row="3" Style="{StaticResource WorkspacePanelContainer}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="3,0,3,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TimelineClockOutline" Foreground="{StaticResource AccentBrushLight}" Width="19" Height="19" Margin="0,0,10,0"/>
                        <TextBlock Text="TIMELINE" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimelineDurationText" Text="  ·  00:00" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="ADD SELECTED" Click="AddSelected_Click" Style="{StaticResource EditorToolButton}"/>
                        <Button Content="◀ MOVE" Click="MoveLeft_Click" Style="{StaticResource EditorToolButton}"/>
                        <Button Content="MOVE ▶" Click="MoveRight_Click" Style="{StaticResource EditorToolButton}"/>
                        <Button Content="REMOVE" Click="Remove_Click" Style="{StaticResource EditorToolButton}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="VIDEO" Width="76" Foreground="{StaticResource AccentBrushLight}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Drag clips to reorder · double-click library entries to add them"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource RenderTimelineTrackBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        AllowDrop="True" Drop="Timeline_Drop" DragOver="Timeline_DragOver">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ListBox x:Name="TimelineList" ItemsSource="{Binding TimelineItems}"
                                 SelectedIndex="-1" SelectionChanged="TimelineList_SelectionChanged"
                                 PreviewMouseMove="TimelineList_PreviewMouseMove"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Ordered video clips">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding PixelWidth}" Height="100" Background="{StaticResource RenderTimelineClipBrush}"
                                            BorderBrush="#668BC2" BorderThickness="1"
                                            CornerRadius="5" Margin="2,6" Padding="9,8">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="MoviePlayOutline" Width="20" Height="20"
                                                                     Foreground="#9CCDF5" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding TimeDisplay}" Foreground="#BED6F5" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="3" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="MUSIC" Foreground="#C6A5EA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{StaticResource RenderTimelineMusicBrush}" CornerRadius="4" Padding="9,4" Height="25">
                        <TextBlock x:Name="MusicLaneText" Text="No background music · select an audio file in the inspector"
                                   Foreground="#DDCEF8" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
