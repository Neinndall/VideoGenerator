<UserControl x:Class="VideoGenerator.Views.EventRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="MAPPING &amp; LORE ENGINE" 
                       FontSize="28" 
                       FontWeight="Black" 
                       Foreground="{StaticResource TextHighlightBrush}" />
            <TextBlock Text="Orchestrate logic behaviors, thematic groupings, and champion identity mapping." 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       Opacity="0.7" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- MAIN CONTENT AREA -->
        <TabControl Grid.Row="1" 
                    Style="{StaticResource LoreEngineTabControl}">
            
            <!-- SECTION 1: EVENT RULES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cogs" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="EVENT RULES" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NEW BEHAVIOR" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24"/>
                            
                            <TextBox x:Name="KeywordBox" materialDesign:HintAssist.Hint="Folder Keyword" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            <TextBox x:Name="TranslationKeyBox" materialDesign:HintAssist.Hint="Dict Key" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            <TextBox x:Name="IconLookupBox" materialDesign:HintAssist.Hint="Icon Lookup (Optional)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="IconTypeBox" Grid.Column="0" materialDesign:HintAssist.Hint="Category" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0">
                                    <sys:String>generic</sys:String>
                                    <sys:String>champion</sys:String>
                                    <sys:String>item</sys:String>
                                    <sys:String>monster</sys:String>
                                    <sys:String>structure</sys:String>
                                    <sys:String>region</sys:String>
                                </ComboBox>
                                <ComboBox x:Name="RuleTypeBox" Grid.Column="1" materialDesign:HintAssist.Hint="Behavior" Style="{StaticResource ModernComboBoxStyle}">
                                    <sys:String>Simple</sys:String>
                                    <sys:String>Target</sys:String>
                                    <sys:String>Interaction</sys:String>
                                </ComboBox>
                            </Grid>
                            
                            <Button Content="REGISTER RULE" Click="AddRule_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="RULES REPOSITORY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KEYWORD" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="DICT KEY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="ICON / LOOKUP" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding RuleManager.Rules}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TranslationKey}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconType}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                                                    <TextBlock Text="{Binding IconLookup}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" Opacity="0.7"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource HUDBorder}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Button Grid.Column="4" Click="DeleteRule_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 2: THEMATIC GROUPS -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewGridOutline" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="GROUPS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NEW THEMATIC GROUP" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24"/>
                            <TextBox x:Name="GroupNameBox" materialDesign:HintAssist.Hint="Group Name" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            <ComboBox x:Name="GroupCategoryBox" materialDesign:HintAssist.Hint="Category" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,20">
                                <sys:String>Region</sys:String>
                                <sys:String>Skinline</sys:String>
                                <sys:String>Class</sys:String>
                                <sys:String>Race</sys:String>
                                <sys:String>Faction</sys:String>
                                <sys:String>Custom</sys:String>
                            </ComboBox>
                            <TextBox x:Name="ChampionsBox" materialDesign:HintAssist.Hint="Champs (Comma separated)" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="140" VerticalContentAlignment="Top" Padding="12" Margin="0,0,0,24"/>
                            <Button Content="ADD GROUP" Click="AddGroup_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Group" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="THEMES REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="CATEGORY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="CHAMPIONS" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding GroupManager.Groups}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Style="{StaticResource AccentTagBorder}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsOfficial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="OFFICIAL" FontSize="8" Foreground="{StaticResource SuccessBrush}" FontWeight="Black"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ChampionsRaw}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas"/>
                                                <Button Grid.Column="3" Click="DeleteGroup_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 3: CHAMPIONS & ALIASES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountMultiple" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="CHAMPIONS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>
 
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NEW CHAMPION / ALIAS" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24"/>
                            <TextBox x:Name="AliasDisplayBox" materialDesign:HintAssist.Hint="Champion Name (e.g. Locke)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            <TextBox x:Name="AliasInternalBox" materialDesign:HintAssist.Hint="Internal System Name (Optional)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,24"/>
                            
                            <Button Content="ADD CHAMPION" Click="AddAlias_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" Margin="0,0,0,24" FontWeight="Black"/>
                            
                            <Border Background="#0D3B82F6" BorderBrush="#303B82F6" BorderThickness="1" Padding="20" CornerRadius="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource InfoBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="SYSTEM NOTE" FontSize="10" FontWeight="Black" Foreground="{StaticResource InfoBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Add custom champions or custom spellings. For official Riot names, specify the exact internal system name if it differs (e.g. display Wukong -> internal MonkeyKing)." 
                                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountBoxMultiple" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="ALIASES REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISPLAY" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="INT NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding AliasManager.Aliases}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Style="{StaticResource AccentTagBorder}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsOfficial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="OFFICIAL" FontSize="8" Foreground="{StaticResource SuccessBrush}" FontWeight="Black"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InternalName}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="11"/>
                                                <Button Grid.Column="3" Click="DeleteAlias_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 4: MONSTERS -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Ghost" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="MONSTERS" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NEW MONSTER" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24"/>
                            <TextBox x:Name="NewMonsterBox" materialDesign:HintAssist.Hint="Monster Name (e.g. Zebra)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,24"/>
                            <Button Content="ADD MONSTER" Click="AddMonster_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Ghost" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="MONSTERS REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MONSTER NAME" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding MonsterList}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Button Grid.Column="1" Click="DeleteMonster_Click" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SECTION 5: STRUCTURES -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HomeModern" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="STRUCTURES" VerticalAlignment="Center" FontSize="12" FontWeight="Black"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NEW STRUCTURE MAPPING" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24"/>
                            <TextBox x:Name="NewStructureKeywordBox" materialDesign:HintAssist.Hint="Folder Keyword (e.g. Tower)" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                            
                            <ComboBox x:Name="NewStructureTargetBox" materialDesign:HintAssist.Hint="Map Target Icon" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,24">
                                <sys:String>Turret</sys:String>
                                <sys:String>Inhibitor</sys:String>
                                <sys:String>Nexus</sys:String>
                            </ComboBox>
                            
                            <Button Content="ADD STRUCTURE" Click="AddStructure_Click" Style="{StaticResource ModernPrimaryButton}" Height="52" FontWeight="Black"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModernContainer}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HomeModern" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="STRUCTURES REPO" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KEYWORD" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="MAP TARGET ICON" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" 
                                     ItemsSource="{Binding StructureList}"
                                     Style="{StaticResource NonSelectableListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TargetName}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <Button Grid.Column="2" Click="DeleteStructure_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
