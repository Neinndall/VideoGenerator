<UserControl x:Class="VideoGenerator.Views.EventRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="32,8,32,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Mapping &amp; Lore Engine" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   Margin="0,24,0,16" 
                   FontWeight="Bold"/>
                   
        <TextBlock Grid.Row="1" 
                   Text="Configure how the application interprets events and lore-based groupings like regions and skinlines." 
                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                   Opacity="0.7"
                   Margin="0,0,0,24" />

        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
            <!-- TAB 1: EVENT RULES -->
            <TabItem Header="EVENT RULES">
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create New Rule" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBox x:Name="KeywordBox" materialDesign:HintAssist.Hint="Folder Keyword (e.g. Dance)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <TextBox x:Name="TranslationKeyBox" materialDesign:HintAssist.Hint="Dictionary Key (e.g. event_dance)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <ComboBox x:Name="IconTypeBox" materialDesign:HintAssist.Hint="Icon Category" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                                <sys:String>generic</sys:String>
                                <sys:String>champion</sys:String>
                                <sys:String>item</sys:String>
                                <sys:String>monster</sys:String>
                            </ComboBox>
                            <ComboBox x:Name="RuleTypeBox" materialDesign:HintAssist.Hint="Logic Behavior" Style="{StaticResource ModernComboBox}" Margin="0,0,0,24">
                                <sys:String>Simple</sys:String>
                                <sys:String>Target</sys:String>
                                <sys:String>Interaction</sys:String>
                            </ComboBox>
                            <Button Content="ADD RULE" Click="AddRule_Click" Style="{StaticResource ModernActionButton}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Style="{StaticResource ModernCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="KEYWORD" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="DICTIONARY KEY" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="ICON" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontWeight="Bold" Opacity="0.4" FontSize="11"  HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RuleManager.Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TranslationKey}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Opacity="0.9"/>
                                                <TextBlock Grid.Column="2" Text="{Binding IconType}" VerticalAlignment="Center" Opacity="0.6" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Type}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Opacity="0.8" Foreground="{StaticResource PrimaryGradientBrush}"/>
                                                <Button Grid.Column="4" Click="DeleteRule_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="#FF5252" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- TAB 2: THEMATIC GROUPS -->
            <TabItem Header="THEMATIC GROUPS">
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create New Group" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBox x:Name="GroupNameBox" materialDesign:HintAssist.Hint="Group Name (e.g. Yordle)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <ComboBox x:Name="GroupCategoryBox" materialDesign:HintAssist.Hint="Category" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                                <sys:String>Region</sys:String>
                                <sys:String>Skinline</sys:String>
                                <sys:String>Class</sys:String>
                                <sys:String>Race</sys:String>
                                <sys:String>Faction</sys:String>
                                <sys:String>Custom</sys:String>
                            </ComboBox>
                            <TextBox x:Name="ChampionsBox" materialDesign:HintAssist.Hint="Champions (Comma separated)" Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top" Padding="12" Margin="0,0,0,24"/>
                            <Button Content="ADD GROUP" Click="AddGroup_Click" Style="{StaticResource ModernActionButton}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Style="{StaticResource ModernCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GROUP NAME" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="CATEGORY" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="CHAMPIONS" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                </Grid>
                            </Border>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding GroupManager.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                                                    <Border Background="#3300E676" HorizontalAlignment="Left" CornerRadius="4" Padding="4,0" Margin="0,2,0,0" Visibility="{Binding IsOfficial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="OFFICIAL" FontSize="8" Foreground="#00E676" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ChampionsRaw}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" FontSize="11" FontFamily="Consolas"/>
                                                <Button Grid.Column="3" Click="DeleteGroup_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="#FF5252" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- TAB 3: CHAMPION ALIASES -->
            <TabItem Header="CHAMPION ALIASES">
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create New Alias" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBox x:Name="AliasDisplayBox" materialDesign:HintAssist.Hint="Display Name (e.g. Wukong)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <TextBox x:Name="AliasInternalBox" materialDesign:HintAssist.Hint="Riot Internal Name (e.g. MonkeyKing)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,24"/>
                            <Button Content="ADD ALIAS" Click="AddAlias_Click" Style="{StaticResource ModernActionButton}"/>
                            
                            <Border Background="#33FFB300" Margin="0,24,0,0" Padding="12" CornerRadius="8">
                                <TextBlock Text="Tip: Internal names are used for DDragon and Community Dragon URLs. Use 'MonkeyKing' for Wukong, 'Leblanc' for LeBlanc, etc." 
                                           TextWrapping="Wrap" FontSize="11" Foreground="#FFB300" Opacity="0.9"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Style="{StaticResource ModernCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISPLAY NAME" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="INTERNAL NAME" FontWeight="Bold" Opacity="0.4" FontSize="11"/>
                                </Grid>
                            </Border>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding AliasManager.Aliases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="White"/>
                                                    <Border Background="#3300E676" HorizontalAlignment="Left" CornerRadius="4" Padding="4,0" Margin="0,2,0,0" Visibility="{Binding IsOfficial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="OFFICIAL" FontSize="8" Foreground="#00E676" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InternalName}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                                                <Button Grid.Column="3" Click="DeleteAlias_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="#FF5252" Width="30" Height="30" Opacity="0.7">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
