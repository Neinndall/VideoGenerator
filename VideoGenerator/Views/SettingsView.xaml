<UserControl x:Class="VideoGenerator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VideoGenerator.Views.Converters">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="{StaticResource WorkspacePagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource WorkspaceHeaderContainer}" Margin="0,0,0,16">
            <StackPanel>
            <TextBlock Text="APPLICATION SYSTEM" Style="{StaticResource WorkspaceEyebrowText}"/>
            <TextBlock Text="Settings" Style="{StaticResource WorkspaceTitleText}" Margin="0,4,0,0"/>
            <TextBlock Text="Adjust global parameters, rendering behaviors, and audio timing." 
                       Style="{StaticResource PageSubtitleText}" 
                       Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings categories remain scrollable while the page context stays fixed. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="0,0,8,0">
        <TabControl Style="{StaticResource LoreEngineTabControl}">
            
            <!-- TAB 1: GENERAL & MEDIA -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GENERAL &amp; MEDIA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                
                <Grid>
                    <Border Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,8,16">
                        <StackPanel>
                            <!-- SECTION: MEDIA DIRECTORY CONFIGURATION -->
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    Padding="24,16" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderMultipleOutline" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"/>
                                    <TextBlock Text="MEDIA DIRECTORY CONFIGURATION" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="24,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Default Media Source Directory" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="The default directory where the app captures character audio folders (e.g., character/locke_base_vo_audio)." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                         <TextBox Text="{Binding Settings.MediaSourceDirectory, Mode=TwoWay}"
                                                  Style="{StaticResource ModernTextBoxWithClear}"
                                                  Width="250" IsReadOnly="True" Margin="0,0,8,0"
                                                  materialDesign:HintAssist.Hint="No directory selected"/>
                                        <Button Click="SelectMediaDirectory_Click" 
                                                Style="{StaticResource IconActionButton}"
                                                Width="36" Height="36">
                                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DIVIDER -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <!-- SECTION: AUDIO ENGINE -->
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    Padding="24,16" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,1,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Headphones" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"/>
                                    <TextBlock Text="AUDIO ENGINE PROPERTIES" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="24,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Silence Between Tracks" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Determines the duration of silence added between concatenated audio files during video encoding." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding SilenceOptions}"
                                              SelectedItem="{Binding Settings.SilenceDuration}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              materialDesign:HintAssist.Hint="Duration (sec)"/>
                                </Grid>
                            </Border>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <Border Padding="24,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Merge Audio Families" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Treats immediate audio subfolders as families and concatenates each family into one track before transcription and rendering."
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding Settings.MergeAudioFamilies, Mode=TwoWay}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- DIVIDER -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <!-- SECTION: DICTIONARY PREFERENCES -->
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    Padding="24,16" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,1,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Translate" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"/>
                                    <TextBlock Text="DICTIONARY PREFERENCES" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="24,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Default Dictionary Language" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="The language selected by default when entering the Dictionary section." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedItem="{Binding Settings.DefaultDictionaryLanguage}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              materialDesign:HintAssist.Hint="Default Language"/>
                                </Grid>
                            </Border>

                            <!-- SYSTEM INFO SECTION -->
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    Padding="24,16" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,1,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"/>
                                    <TextBlock Text="ENGINE INFORMATION" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="24,28" Opacity="0.8">
                                <TextBlock Text="The VideoGenerator engine utilizes FFmpeg for ultra-high precision encoding. All settings are persistent across sessions and stored in the local configuration repository." 
                                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontStyle="Italic" LineHeight="18"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- TAB 2: TRANSCRIPTION -->
            <TabItem Style="{StaticResource LoreEngineTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Microphone" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TRANSCRIPTION ENGINE" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                
                <Grid>
                    <Border Style="{StaticResource WorkspacePanelContainer}" Padding="0" Margin="0,0,8,16">
                        <StackPanel>
                            <!-- SECTION: TRANSCRIPTION ENGINE -->
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    Padding="24,16" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Microphone" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"/>
                                    <TextBlock Text="TRANSCRIPTION ENGINE PROPERTIES" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="24,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Enable Subtitles &amp; Audio Transcription" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Automatically transcribe character voice audios using Whisper and display the speech bubble on videos and preview." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="1" 
                                                  IsChecked="{Binding Settings.EnableTranscriptions, Mode=TwoWay}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- DIVIDER -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <!-- Whisper Model -->
                            <Border Padding="24,28" IsEnabled="{Binding Settings.EnableTranscriptions}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Whisper Model Size" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Select the size of the Whisper speech-to-text model. Base is recommended. Larger models require downloading." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding WhisperModelOptions}"
                                              SelectedItem="{Binding Settings.WhisperModel}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              materialDesign:HintAssist.Hint="Model Size"/>
                                </Grid>
                            </Border>

                            <!-- DIVIDER -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <!-- Whisper CPU Threads -->
                            <Border Padding="24,28" IsEnabled="{Binding Settings.EnableTranscriptions}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Whisper CPU Threads" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Set the number of CPU threads for Speech-to-Text. More threads speed up transcription but increase CPU usage." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Settings.WhisperThreadCount}" 
                                                       Width="30" DockPanel.Dock="Right" TextAlignment="Right" 
                                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding Settings.WhisperThreadCount, Mode=TwoWay}"
                                                    Minimum="1" 
                                                    Maximum="{Binding MaxCpuThreads}" 
                                                    TickFrequency="1" IsSnapToTickEnabled="True" 
                                                    Style="{StaticResource ModernSlider}"
                                                    VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DIVIDER -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                            <!-- Whisper Language -->
                            <Border Padding="24,28" IsEnabled="{Binding Settings.EnableTranscriptions}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="Transcription Audio Language" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Force Whisper to transcribe in a specific language to prevent translation errors or language confusion." 
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding WhisperLanguageOptions}"
                                              SelectedValue="{Binding Settings.WhisperLanguage, Mode=TwoWay}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Key"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              materialDesign:HintAssist.Hint="Language"/>
                                </Grid>
                             </Border>

                             <!-- DIVIDER -->
                             <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                             <!-- Clean Whisper Hallucinations -->
                             <Border Padding="24,28" IsEnabled="{Binding Settings.EnableTranscriptions}">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="200"/>
                                     </Grid.ColumnDefinitions>

                                     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                         <TextBlock Text="Clean Ambient Audio Tags" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                         <TextBlock Text="Automatically strip non-speech ambient audio tags in square brackets like [BLANK_AUDIO] or [MUSIC] from transcriptions." 
                                                    TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                     </StackPanel>

                                     <ToggleButton Grid.Column="1" 
                                                   IsChecked="{Binding Settings.CleanWhisperHallucinations, Mode=TwoWay}"
                                                   Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                 </Grid>
                             </Border>

                             <!-- DIVIDER -->
                             <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="24,0"/>

                                                           <!-- Force Re-transcription on Dialogue Preparation -->
                              <Border Padding="24,28" IsEnabled="{Binding Settings.EnableTranscriptions}">
                                  <Grid>
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="200"/>
                                      </Grid.ColumnDefinitions>

                                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                          <TextBlock Text="Force Dialogue Re-transcription" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                          <TextBlock Text="Ignore cached transcriptions in dialogues.json during dialogue preparation and force Whisper to re-transcribe all audio files." 
                                                     TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" FontSize="11" Margin="0,4,0,0"/>
                                      </StackPanel>

                                      <ToggleButton Grid.Column="1" 
                                                    IsChecked="{Binding Settings.ForceBatchRetranscribe, Mode=TwoWay}"
                                                    Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"/>
                                  </Grid>
                              </Border>
                         </StackPanel>
                     </Border>
                </Grid>
            </TabItem>
        </TabControl>
        </ScrollViewer>
    </Grid>
</UserControl>
