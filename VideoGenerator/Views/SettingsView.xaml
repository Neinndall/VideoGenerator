<UserControl x:Class="VideoGenerator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:settingsViews="clr-namespace:VideoGenerator.Views.Settings">
    <!-- Category navigation is the page header, as in Event Mapping.
         All three real settings sections remain accessible without a redundant hero. -->
    <Grid Margin="{StaticResource WorkspacePagePadding}" Background="Transparent">
        <!-- Functional sections retain their original order and names; each
             hosted view manages its own scrolling and persists real settings. -->
        <TabControl x:Name="SettingsTabs"
                    Style="{StaticResource SettingsNavigationTabControl}"
                    SelectedIndex="0" KeyboardNavigation.TabNavigation="Continue"
                    AutomationProperties.Name="Settings categories">
            <TabItem Style="{StaticResource SettingsNavigationTabItem}"
                     AutomationProperties.Name="General and media settings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderMultipleOutline"
                                                 Width="17" Height="17" Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                        <TextBlock Text="GENERAL &amp; MEDIA" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                    </StackPanel>
                </TabItem.Header>
                <settingsViews:GeneralSettingsView x:Name="GeneralPanel"/>
            </TabItem>

            <TabItem Style="{StaticResource SettingsNavigationTabItem}"
                     AutomationProperties.Name="Processing settings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LayersOutline"
                                                 Width="17" Height="17" Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                        <TextBlock Text="PROCESSING" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                    </StackPanel>
                </TabItem.Header>
                <settingsViews:ProductionSettingsView/>
            </TabItem>

            <TabItem Style="{StaticResource SettingsNavigationTabItem}"
                     AutomationProperties.Name="Transcription settings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MicrophoneOutline"
                                                 Width="17" Height="17" Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                        <TextBlock Text="TRANSCRIPTION" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                    </StackPanel>
                </TabItem.Header>
                <settingsViews:TranscriptionSettingsView/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
