<UserControl x:Class="VideoGenerator.Views.BackgroundDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:VideoGenerator.Services"
             xmlns:converters="clr-namespace:VideoGenerator.Converters">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:FileNameConverter x:Key="FileNameConverter"/>
    </UserControl.Resources>

    <Grid Margin="32,8,32,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Background Design" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                   Margin="0,24,0,32" 
                   FontWeight="Bold"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <materialDesign:Card Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="Custom Background" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>
                        <Button Content="SELECT IMAGE" 
                                Click="SelectBackground_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,12" 
                              Visibility="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath, Converter={StaticResource NullToVisibilityConverter}}">
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    CornerRadius="8" 
                                    Padding="12,4,4,4"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath, Converter={StaticResource FileNameConverter}}" 
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Opacity="0.9"/>
                                    <Button Grid.Column="1" 
                                            Click="RemoveBackground_Click"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="#FF5252"
                                            Width="28"
                                            Height="28"
                                            ToolTip="Remove Background">
                                        <materialDesign:PackIcon Kind="CloseCircle" Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,12"/>
                        <TextBlock Text="Champion Splash Search" Style="{StaticResource MaterialDesignCaptionTextBlock}" FontWeight="Bold" Opacity="0.6" Margin="0,12,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SplashSearchBox" 
                                     materialDesign:HintAssist.Hint="Champion Name" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" 
                                    Content="{materialDesign:PackIcon Kind=Search}" 
                                    Click="SearchSplash_Click"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                    Width="32" Height="32"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Preview Customization" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Preview Text" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Text Vertical Position" Style="{StaticResource MaterialDesignCaptionTextBlock}" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="-50" Maximum="50" 
                                    Value="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset}"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset, StringFormat={}{0:F0}px}"
                                       VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- Preview Area (Pure XAML Overlay) -->
            <StackPanel Grid.Column="1">
                <materialDesign:Card Style="{StaticResource ModernCard}" Padding="4" Margin="0,0,0,12">
                    <!-- Viewbox ensures the 1920x1080 grid scales perfectly keeping its ratio -->
                    <Viewbox MaxHeight="500" Stretch="Uniform">
                        <Grid Width="1920" Height="1080" Background="#0D0D0D">
                            <!-- 1. Actual Background Image -->
                            <Image Source="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath}" 
                                   Stretch="UniformToFill"/>

                            <!-- 2. Fallback Central Icon (MaterialDesign ImageOutline) -->
                            <materialDesign:PackIcon Kind="ImageOutline" 
                                                    Width="300" Height="300" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" 
                                                    Opacity="0.1" 
                                                    Foreground="White"
                                                    Visibility="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- 3. HUD Ribbon (Sincronizado con Python) -->
                            <Border VerticalAlignment="Top" 
                                    Margin="0,898,0,0" 
                                    Height="120" 
                                    Background="#96000000" 
                                    BorderBrush="White" 
                                    BorderThickness="0,2,0,2">
                                <!-- HUD Text -->
                                <TextBlock Text="{Binding PreviewText}" 
                                           Foreground="White" 
                                           FontSize="52" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>

                            <!-- 4. HUD Icon Placeholder (Sincronizado con Python) -->
                            <Border HorizontalAlignment="Left" 
                                    VerticalAlignment="Top" 
                                    Margin="50,698,0,0" 
                                    Width="180" Height="180" 
                                    Background="#1AFFFFFF"
                                    BorderBrush="#80FFFFFF" 
                                    BorderThickness="2"
                                    CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ImageFilterCenterFocusWeak" 
                                                            Foreground="#A0FFFFFF" 
                                                            Width="64" Height="64" 
                                                            HorizontalAlignment="Center" />
                                    <TextBlock Text="ICON AREA" 
                                               Foreground="#80FFFFFF" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Margin="0,8,0,0" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Global 1px Frame -->
                            <Border BorderBrush="White" BorderThickness="1" Opacity="0.5"/>
                        </Grid>
                    </Viewbox>
                </materialDesign:Card>
                
                <TextBlock Text="Note: This HUD layout exactly represents the final video output (1920x1080)." 
                           Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                           HorizontalAlignment="Center"
                           FontStyle="Italic"
                           Opacity="0.6"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
