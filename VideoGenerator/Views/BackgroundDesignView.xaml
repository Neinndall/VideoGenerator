<UserControl x:Class="VideoGenerator.Views.BackgroundDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:VideoGenerator.Services"
             xmlns:converters="clr-namespace:VideoGenerator.Views.Converters">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:FileNameConverter x:Key="FileNameConverter"/>
        
        <!-- Local specific resources for the designer -->
        <Style x:Key="InspectorSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. CINEMATIC HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="HUD &amp; VISUAL DESIGNER" 
                           FontSize="28" 
                           FontWeight="Black" 
                           Foreground="{StaticResource TextHighlightBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                        <TextBlock Text="v1.1.0.0" FontSize="9" FontWeight="Black" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Professional 1920x1080 render canvas for dynamic video overlays." 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN DESIGNER WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Left: Inspector -->
                <ColumnDefinition Width="*"/>   <!-- Right: Live Canvas -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: PROPERTIES INSPECTOR -->
            <Border Grid.Column="0" Style="{StaticResource ModernContainer}" Padding="0" Margin="0,0,24,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SECTION: CANVAS SOURCE -->
                        <Border Background="{StaticResource SurfaceBrush}" Padding="20,14" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageOutline" Foreground="{StaticResource AccentBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="CANVAS SOURCE" Style="{StaticResource InspectorSectionHeader}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="20,24">
                            <StackPanel>
                            <Button Click="SelectBackground_Click"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    Height="44" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudUploadOutline" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                    <TextBlock Text="UPLOAD ASSET" VerticalAlignment="Center" FontSize="11" FontWeight="Black"/>
                                </StackPanel>
                            </Button>

                            <!-- Current Asset Info -->
                            <Border Style="{StaticResource HUDBorder}" Padding="12" 
                                    Visibility="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="FileImageOutline" Foreground="{StaticResource AccentBrush}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath, Converter={StaticResource FileNameConverter}}" 
                                               FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Click="RemoveBackground_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource ErrorBrush}" Width="24" Height="24" Padding="0">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="20,0"/>

                        <!-- SECTION: LORE SPLASH RESOLVER -->
                        <Border Background="{StaticResource SurfaceBrush}" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource AccentBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="SPLASH RESOLVER" Style="{StaticResource InspectorSectionHeader}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="20,24">
                            <StackPanel>
                            <TextBlock Text="Resolve high-quality champion splashes directly from Riot API." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,8" TextWrapping="Wrap" Opacity="0.6"/>
                            <Grid>
                                <TextBox x:Name="SplashSearchBox" 
                                         materialDesign:HintAssist.Hint="Champion name..." 
                                         Style="{StaticResource CompactModernTextBox}"
                                         Padding="12,10" Height="40"/>
                                <Button Click="SearchSplash_Click" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource AccentBrush}" Width="36" Height="36">
                                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="20,0"/>

                        <!-- SECTION: TYPOGRAPHY OFFSETS -->
                        <Border Background="{StaticResource SurfaceBrush}" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatVerticalAlignBottom" Foreground="{StaticResource AccentBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="TYPOGRAPHY ENGINE" Style="{StaticResource InspectorSectionHeader}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="20,24">
                            <StackPanel>
                            <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Live Preview Text" 
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,24"/>

                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="VERTICAL OFFSET" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset, StringFormat={}{0:F0}px}" 
                                               HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" 
                                        Value="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset}"
                                        Style="{StaticResource ModernSlider}"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: LIVE CINEMA CANVAS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cinematic Viewport -->
                <Border Grid.Row="0" Style="{StaticResource ModernContainer}" Padding="16" Background="#050505">
                    <Grid>
                        <!-- Grid Overlay (Technician look) -->
                        <Border Opacity="0.03" IsHitTestVisible="False">
                            <Border.Background>
                                <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Grid Width="40" Height="40">
                                            <Path Data="M 0 0 L 40 0 M 0 0 L 0 40" Stroke="White" StrokeThickness="1"/>
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.Background>
                        </Border>

                        <Viewbox Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="1920" Height="1080" Background="#0D0D0F" x:Name="RenderCanvas">
                                <!-- 1. Background Content -->
                                <Image Source="{Binding Source={x:Static services:AppSettings.Instance}, Path=CustomBackgroundPath}" 
                                       Stretch="UniformToFill">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="100" ShadowDepth="0" Opacity="0.5"/>
                                    </Image.Effect>
                                </Image>

                                <!-- 2. HUD Elements -->
                                <Grid>
                                    <!-- Central Title Overlay -->
                                    <Border VerticalAlignment="Top" Margin="0,898,0,0" Height="120" Background="#CC000000" BorderBrush="White" BorderThickness="0,2,0,2">
                                        <TextBlock Text="{Binding PreviewText}" Foreground="White" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="{Binding Source={x:Static services:AppSettings.Instance}, Path=TextVerticalOffset}"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <!-- Square Avatar (Champ/Item) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,698,0,0" Width="180" Height="180" Background="#26FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="3" CornerRadius="4">
                                        <materialDesign:PackIcon Kind="ImageFilterCenterFocusWeak" Foreground="White" Opacity="0.4" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- 3. Safe Area Guides (Technician Mode) -->
                                <Border BorderBrush="Cyan" BorderThickness="1" Opacity="0.1" Margin="100" IsHitTestVisible="False"/>
                                <Border BorderBrush="White" BorderThickness="1" Opacity="0.3"/>
                            </Grid>
                        </Viewbox>
                        
                        <!-- Zoom Label -->
                        <Border Background="#CC161618" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="12,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MagnifyPlus" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE PREVIEW (1080P)" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextHighlightBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer Status -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Changes are synchronized in real-time with the global video engine." 
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
