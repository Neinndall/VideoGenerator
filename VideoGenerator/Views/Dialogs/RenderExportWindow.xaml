<Window x:Class="VideoGenerator.Views.Dialogs.RenderExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Render As... — Export Montage"
        Height="700" Width="1020"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellContentGradientBrush}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="DialogSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main content (Presets + Customizer) -->
            <RowDefinition Height="*"/>
            <!-- 2: Progress & Action footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Style="{StaticResource WorkspacePanelHeader}" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="MoviePlayOutline" Foreground="{StaticResource AccentBrushLight}"
                                             Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RENDER AS..." FontWeight="Black" FontSize="15" Foreground="{StaticResource TextHighlightBrush}"/>
                            <TextBlock Text="  ·  CUSTOMIZABLE EXPORT TEMPLATES" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrushLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ProjectSummaryText" Text="Untitled montage · 0 clips · 00:00 total"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Left: Presets Tree / List -->
                <ColumnDefinition Width="340" MinWidth="280"/>
                <ColumnDefinition Width="14"/>
                <!-- Right: Template Customizer & Output -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PRESETS LIST -->
            <Border Grid.Column="0" Style="{StaticResource WorkspacePanelContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                        <RowDefinition Height="*"/>    <!-- List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource WorkspacePanelHeader}" CornerRadius="12,12,0,0" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewList" Foreground="{StaticResource AccentBrushLight}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="OUTPUT TEMPLATES" FontWeight="SemiBold" Foreground="{StaticResource AccentBrushLight}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Search & Filter tabs -->
                    <Border Grid.Row="1" Background="{StaticResource WorkspaceFilterBarBrush}" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Height="32" Padding="8,4"
                                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Filter templates"
                                     Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAllRadio" Content="ALL" IsChecked="True" Checked="FilterRadio_Checked"
                                             Style="{StaticResource {x:Type ToggleButton}}" Width="68" Height="24" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <RadioButton x:Name="FilterBuiltInRadio" Content="BUILT-IN" Checked="FilterRadio_Checked"
                                             Style="{StaticResource {x:Type ToggleButton}}" Width="78" Height="24" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <RadioButton x:Name="FilterCustomRadio" Content="CUSTOM" Checked="FilterRadio_Checked"
                                             Style="{StaticResource {x:Type ToggleButton}}" Width="76" Height="24" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Templates ListBox -->
                    <ListBox Grid.Row="2" x:Name="PresetsListBox"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="PresetsListBox_SelectionChanged"
                             AutomationProperties.Name="Render templates">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4" Margin="2,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextHighlightBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SummaryDisplay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4"
                                                Background="{StaticResource WorkspacePanelSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding IsBuiltIn, Converter={x:Null}}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrushLight}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Preset Actions -->
                    <Border Grid.Row="3" Background="{StaticResource WorkspaceFilterBarBrush}" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="+ NEW TEMPLATE" Click="NewCustomPreset_Click" Style="{StaticResource ModernSecondaryButton}" Height="30" FontSize="10" FontWeight="Bold"/>
                            <Button Grid.Column="1" x:Name="DeletePresetButton" Content="DELETE" Click="DeletePreset_Click"
                                    IsEnabled="False" Style="{StaticResource ModernSecondaryButton}" Height="30" FontSize="10" FontWeight="Bold" Margin="6,0,0,0" Padding="10,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: TEMPLATE CUSTOMIZER -->
            <Border Grid.Column="2" Style="{StaticResource WorkspacePanelContainer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Settings ScrollViewer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource WorkspacePanelHeader}" CornerRadius="12,12,0,0" Padding="16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tune" Foreground="{StaticResource AccentBrushLight}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CUSTOMIZE TEMPLATE" FontWeight="SemiBold" Foreground="{StaticResource AccentBrushLight}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TemplateBadgeText" Text="BUILT-IN TEMPLATE" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                        <StackPanel>
                            <!-- Template Name & Description -->
                            <TextBlock Text="TEMPLATE NAME" Style="{StaticResource DialogSectionHeader}"/>
                            <TextBox x:Name="PresetNameBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="10,6" Margin="0,0,0,10"
                                     TextChanged="CustomSetting_Changed"/>
                            <TextBox x:Name="PresetDescBox" Style="{StaticResource ModernTextBox}" Height="32" Padding="10,4" Margin="0,0,0,16"
                                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextChanged="CustomSetting_Changed"/>

                            <!-- Video Settings Group -->
                            <Border Style="{StaticResource WorkspacePanelContainer}" Padding="14" Margin="0,0,0,14" Background="{StaticResource WorkspaceContentWellBrush}">
                                <StackPanel>
                                    <TextBlock Text="VIDEO SETTINGS" Style="{StaticResource DialogSectionHeader}"/>

                                    <!-- Standard Resolution selector -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FORMAT PRESET" Style="{StaticResource DialogFieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="StandardResComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="StandardResComboBox_SelectionChanged" Height="34"/>
                                    </Grid>

                                    <!-- Width x Height inputs -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FRAME SIZE (W × H)" Style="{StaticResource DialogFieldLabel}"/>
                                        <TextBox Grid.Column="1" x:Name="WidthBox" Style="{StaticResource ModernTextBox}" Height="34" Padding="8,4" TextChanged="CustomSetting_Changed"/>
                                        <TextBlock Grid.Column="2" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox Grid.Column="3" x:Name="HeightBox" Style="{StaticResource ModernTextBox}" Height="34" Padding="8,4" TextChanged="CustomSetting_Changed"/>
                                    </Grid>

                                    <!-- Frame rate -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FRAME RATE" Style="{StaticResource DialogFieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="FpsComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="CustomSetting_Changed" Height="34">
                                            <ComboBoxItem Content="24 FPS (Cinematic)"/>
                                            <ComboBoxItem Content="30 FPS (Standard Video)"/>
                                            <ComboBoxItem Content="60 FPS (Smooth Gaming)"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Video Encoder -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VIDEO ENCODER" Style="{StaticResource DialogFieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="EncoderComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="CustomSetting_Changed" Height="34">
                                            <ComboBoxItem Content="CPU (H.264 · libx264) - Universal compatibility" Tag="libx264"/>
                                            <ComboBoxItem Content="NVIDIA NVENC (H.264 · h264_nvenc) - Fast GPU" Tag="h264_nvenc"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Quality / CRF -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="CONSTANT RATE FACTOR (CRF)" Style="{StaticResource DialogFieldLabel}"/>
                                            <TextBlock x:Name="CrfValueText" Text="CRF 21 · Balanced Quality" HorizontalAlignment="Right"
                                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrushLight}"/>
                                        </Grid>
                                        <Slider Grid.Row="1" x:Name="CrfSlider" Minimum="15" Maximum="32" Value="21"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                                ValueChanged="CrfSlider_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Audio Settings Group -->
                            <Border Style="{StaticResource WorkspacePanelContainer}" Padding="14" Margin="0,0,0,14" Background="{StaticResource WorkspaceContentWellBrush}">
                                <StackPanel>
                                    <TextBlock Text="AUDIO SETTINGS" Style="{StaticResource DialogSectionHeader}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="AUDIO BITRATE" Style="{StaticResource DialogFieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="AudioBitrateComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="CustomSetting_Changed" Height="34">
                                            <ComboBoxItem Content="128 kbps (Compact Audio)" Tag="128k"/>
                                            <ComboBoxItem Content="192 kbps (Standard High Quality)" Tag="192k"/>
                                            <ComboBoxItem Content="256 kbps (Studio)" Tag="256k"/>
                                            <ComboBoxItem Content="320 kbps (Maximum Fidelity)" Tag="320k"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SAMPLE RATE" Style="{StaticResource DialogFieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="AudioSampleRateComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="CustomSetting_Changed" Height="34">
                                            <ComboBoxItem Content="48000 Hz (Production Standard)" Tag="48000"/>
                                            <ComboBoxItem Content="44100 Hz (CD Audio)" Tag="44100"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Template Actions (Save / Save As) -->
                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="SaveTemplateButton" Content="SAVE TEMPLATE CHANGES" Click="SaveTemplate_Click"
                                        Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0" Padding="14,0"/>
                                <Button Content="SAVE AS NEW TEMPLATE..." Click="SaveAsNewTemplate_Click"
                                        Style="{StaticResource ModernSecondaryButton}" Height="34" Padding="14,0"/>
                            </WrapPanel>

                            <!-- Output File Destination -->
                            <TextBlock Text="RENDER DESTINATION FILE" Style="{StaticResource DialogSectionHeader}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DestinationPathBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="10,6"
                                         AutomationProperties.Name="Export file path"/>
                                <Button Grid.Column="1" Content="BROWSE..." Click="BrowseDestination_Click"
                                        Style="{StaticResource ModernSecondaryButton}" Height="36" Margin="8,0,0,0" Padding="16,0"/>
                            </Grid>
                            <TextBlock x:Name="EstimatedSizeText" Text="Estimated size: ~0 MB"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER: PROGRESS & ACTIONS -->
        <Border Grid.Row="2" Style="{StaticResource WorkspacePanelHeader}" CornerRadius="12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="RenderStatusText" Text="Ready to render" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="RenderProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="CLOSE" Click="Cancel_Click"
                            Style="{StaticResource ModernSecondaryButton}" Height="40" Padding="20,0" Margin="0,0,10,0"/>
                    <Button x:Name="StartRenderButton" Content="RENDER VIDEO" Click="StartRender_Click"
                            Style="{StaticResource ModernPrimaryButton}" Height="40" Padding="26,0"/>
                    <Button x:Name="OpenFolderButton" Content="OPEN FOLDER" Click="OpenFolder_Click"
                            Visibility="Collapsed" Style="{StaticResource ModernSecondaryButton}" Height="40" Padding="16,0" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
