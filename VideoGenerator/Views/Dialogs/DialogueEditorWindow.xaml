<Window x:Class="VideoGenerator.Views.Dialogs.DialogueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:services="clr-namespace:VideoGenerator.Services"
        xmlns:converters="clr-namespace:VideoGenerator.Views.Converters"
        mc:Ignorable="d"
        Title="Dialogue Editor" 
        Height="730" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NonLockingImageConverter x:Key="NonLockingImageConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Workspace -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Left Panel: Fixed Events Queue -->
            <Border Grid.Column="0"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Fixed panel header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceBrush}"
                            Padding="16,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted"
                                                              Width="16"
                                                              Height="16"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="EVENTS QUEUE"
                                               FontWeight="Black"
                                               Foreground="{StaticResource TextHighlightBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="Review &amp; validate event transcriptions"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Validation Batch Badge -->
                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllBatchValidated}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessPillBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessPillBorderBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                                             Width="12" Height="12" 
                                                             VerticalAlignment="Center" 
                                                             Margin="0,0,5,0"
                                                             Foreground="{StaticResource SuccessBrush}"
                                                             Visibility="{Binding IsAllBatchValidated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock FontSize="9"
                                               FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllBatchValidated}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding ValidationProgressText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Filter Bar: All vs Pending -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource PrimaryBackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" 
                                         Content="{Binding AllFilterLabel}"
                                         IsChecked="{Binding IsAllFilterSelected, Mode=TwoWay}"
                                         Click="FilterRadioButton_Click"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Height="28" FontSize="10" FontWeight="Bold"
                                         HorizontalAlignment="Stretch" Margin="0,0,4,0"/>

                            <RadioButton Grid.Column="1" 
                                         Content="{Binding PendingFilterLabel}"
                                         IsChecked="{Binding IsPendingFilterSelected, Mode=TwoWay}"
                                         Click="FilterRadioButton_Click"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Height="28" FontSize="10" FontWeight="Bold"
                                         HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ListBox of Events -->
                    <ListBox x:Name="EventsListBox" Grid.Row="2"
                             Style="{StaticResource VirtualizedListBoxStyle}"
                             SelectionChanged="EventsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding ParsedData.DisplayText}" FontSize="9" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding CharacterName}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Validation indicator icon -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <!-- Validated icon -->
                                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                                      Width="16"
                                                                      Height="16"
                                                                      Foreground="{StaticResource SuccessBrush}"
                                                                      ToolTip="Dialogue validated"
                                                                      Visibility="{Binding IsDialogueValidated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            
                                            <!-- Pending icon -->
                                            <materialDesign:PackIcon Kind="ClockOutline"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Foreground="{StaticResource TextMutedBrush}"
                                                                      ToolTip="Pending validation"
                                                                      Opacity="0.6">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDialogueValidated}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel: Audio Segment Editor -->
            <Grid Grid.Column="2" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Event Details Header -->
                <Border Grid.Row="0" Style="{StaticResource WorkspaceHeaderContainer}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Resolved Icon -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{StaticResource ElevatedSurfaceBrush}" 
                                BorderBrush="{StaticResource HextechGoldBrush}" 
                                BorderThickness="1.5" 
                                ClipToBounds="True" Margin="0,0,16,0">
                            <Image Source="{Binding SelectedEvent.ParsedData.IconPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NonLockingImageConverter}}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedEvent.FolderName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Black" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedEvent.ParsedData.DisplayText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedEvent.CharacterName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quick Event Validation Toggle -->
                        <Button Grid.Column="2"
                                Click="ValidateCurrentEvent_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                ToolTip="Toggle validation for all segments of this event">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEvent.IsDialogueValidated, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="10" FontWeight="Black" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="VALIDATE EVENT"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEvent.IsDialogueValidated, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="EVENT VALIDATED"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Audio Parts ItemsControl -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl x:Name="PartsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkspacePanelContainer}" Background="{StaticResource SecondaryBackgroundBrush}" Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Play Button -->
                                            <ColumnDefinition Width="*"/>    <!-- Text Editor -->
                                            <ColumnDefinition Width="Auto"/> <!-- Validated Checkbox -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Play/Pause Control -->
                                        <Button Grid.Column="0" Click="PlayPartAudio_Click" 
                                                Style="{StaticResource AudioPlayButton}"
                                                Width="44" Height="44" Margin="0,0,16,0"
                                                ToolTip="Play/Stop this audio segment">
                                            <materialDesign:PackIcon Kind="Play" Width="22" Height="22" x:Name="PlayIcon"/>
                                        </Button>

                                        <!-- Subtitle Edit Box -->
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="DialogueTextBox"
                                                     Text="{Binding Dialogue, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Dialogue Transcript (Segment)"
                                                     Style="{StaticResource CompactModernTextBox}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Height="60" MinHeight="60" MaxHeight="360"
                                                     VerticalContentAlignment="Top" Padding="12,8,20,12"
                                                     VerticalScrollBarVisibility="Auto"/>

                                            <primitives:Thumb Width="16" Height="16"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Bottom"
                                                              Margin="0,0,3,3"
                                                              Cursor="SizeNS"
                                                              Tag="{Binding ElementName=DialogueTextBox}"
                                                              DragDelta="DialogueResizeThumb_DragDelta"
                                                              ToolTip="Drag to resize transcript">
                                                <primitives:Thumb.Template>
                                                    <ControlTemplate TargetType="primitives:Thumb">
                                                        <Grid Background="Transparent">
                                                            <Path Data="M 3,13 L 13,3 M 8,13 L 13,8"
                                                                  Stroke="{StaticResource TextMutedBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </primitives:Thumb.Template>
                                            </primitives:Thumb>
                                        </Grid>

                                        <!-- Validated Toggle -->
                                        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="VALIDATE" FontSize="8" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <CheckBox IsChecked="{Binding IsValidated, UpdateSourceTrigger=PropertyChanged}" 
                                                      Click="PartValidatedCheckBox_Click"
                                                      Style="{StaticResource MaterialDesignCheckBox}" 
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Selected Event Navigation & Actions -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation controls (Prev, Next, Next Pending) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="PrevEvent_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,6,0"
                                ToolTip="Previous Event"
                                IsEnabled="{Binding HasPreviousEvent}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronLeft" Margin="0,0,4,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                <TextBlock Text="PREV" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                            </StackPanel>
                        </Button>

                        <Button Click="NextEvent_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,6,0"
                                ToolTip="Next Event"
                                IsEnabled="{Binding HasNextEvent}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NEXT" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                                <materialDesign:PackIcon Kind="ChevronRight" Margin="4,0,0,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>

                        <Button Click="NextPending_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,6,0"
                                ToolTip="Jump to the next unvalidated event"
                                IsEnabled="{Binding HasPendingEvent}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LightningBolt" Margin="0,0,4,0" VerticalAlignment="Center" Width="15" Height="15" Foreground="{StaticResource HextechGoldBrush}"/>
                                <TextBlock Text="NEXT PENDING" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Action buttons -->
                    <Button Grid.Column="2"
                            Click="TranscribeCurrentEvent_Click"
                            Style="{StaticResource ModernSecondaryButton}"
                            Height="36"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            ToolTip="Run Whisper transcription for the selected event"
                            IsEnabled="{Binding Source={x:Static services:AppSettings.Instance}, Path=EnableTranscriptions}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Microphone" Margin="0,0,8,0" VerticalAlignment="Center" Width="15" Height="15"/>
                            <TextBlock Text="AUTO-TRANSCRIBE" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Click="ApplyEventChanges_Click"
                            Style="{StaticResource ModernPrimaryButton}"
                            Height="36"
                            Padding="16,0"
                            ToolTip="Save dialogue edits and regenerate preview frames">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Margin="0,0,8,0" VerticalAlignment="Center" Width="15" Height="15"/>
                            <TextBlock Text="APPLY CHANGES" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Window Bar -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="BATCH REVIEW"
                               FontSize="9"
                               FontWeight="Black"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding BatchReviewStatusText}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="Cancel_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        Height="40"
                        Padding="16,0"
                        Margin="0,0,8,0">
                    <TextBlock Text="CANCEL" FontSize="10" FontWeight="Black"/>
                </Button>

                <Button Grid.Column="2" Click="Done_Click"
                        Style="{StaticResource ModernPrimaryButton}"
                        Height="40"
                        Padding="20,0"
                        ToolTip="Approve the reviewed batch and close the editor">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="DONE" VerticalAlignment="Center" FontSize="10" FontWeight="Black"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
