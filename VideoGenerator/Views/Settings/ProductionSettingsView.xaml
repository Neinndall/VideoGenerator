<UserControl x:Class="VideoGenerator.Views.Settings.ProductionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0,0,6,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="ProductionCardsGrid" Grid.Row="0"
                  SizeChanged="ProductionCardsGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition x:Name="ProductionSideColumn" Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ProductionMainCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsSectionPanel}"
                        Margin="0,0,10,16" MinHeight="205">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsSectionHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsHeroIconTile}">
                                <materialDesign:PackIcon Kind="Waveform" Style="{StaticResource SettingsHeroGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Audio timeline" Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock Text="Timing and pacing of voice tracks"
                                           Style="{StaticResource SettingsHeroSubtitle}"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                        <StackPanel Margin="18,17,18,20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TimerSand" Style="{StaticResource SettingsFieldGlyph}"/>
                            <TextBlock Text="Silence between tracks" Style="{StaticResource SettingsFieldTitle}"/>
                        </StackPanel>
                        <TextBlock Text="Space inserted between concatenated voice clips."
                                   Style="{StaticResource SettingsFieldDescription}" Margin="0,4,0,11"/>
                        <ComboBox ItemsSource="{Binding SilenceOptions}"
                                  SelectedItem="{Binding Settings.SilenceDuration, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Silence between tracks in seconds"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ProductionSideCard" Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource SettingsSectionPanel}" Margin="10,0,0,16" MinHeight="205">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsSectionHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsHeroIconTile}">
                                <materialDesign:PackIcon Kind="Layers" Style="{StaticResource SettingsHeroGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Audio families" Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock Text="How related voice lines are grouped"
                                           Style="{StaticResource SettingsHeroSubtitle}"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                        <StackPanel Margin="18,17,18,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SourceMerge" Style="{StaticResource SettingsFieldGlyph}"/>
                                    <TextBlock Text="Merge audio families" Style="{StaticResource SettingsFieldTitle}"/>
                                </StackPanel>
                                <TextBlock Text="Combine immediate subfolder tracks before transcription and rendering."
                                           Style="{StaticResource SettingsFieldDescription}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                IsChecked="{Binding Settings.MergeAudioFamilies, Mode=TwoWay}"
                                Style="{StaticResource SettingsSwitchToggle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                AutomationProperties.Name="Merge audio families"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource SettingsInsetCard}" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                        Foreground="{StaticResource SettingsCyanBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                        Text="Changes affect future audio preparation. Previously generated media remains in its original location."
                        TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
