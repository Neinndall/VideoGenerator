<UserControl x:Class="VideoGenerator.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Traditional settings layout: one full-width section per functional group. -->
        <Style x:Key="GeneralSectionPanel" TargetType="Border" BasedOn="{StaticResource SettingsSectionPanel}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource WorkspacePanelSurfaceBrush}"/>
        </Style>
        <Style x:Key="GeneralFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GeneralHelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <!-- The icon and native TextBox content share a single rounded outline.
             No MaterialDesign hint is attached to this path field. -->
        <Style x:Key="GeneralDirectoryPathField" TargetType="TextBox">
            <Setter Property="Height" Value="41"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PathBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="FolderOutline"
                                                         Width="18" Height="18"
                                                         Foreground="{StaticResource SettingsCyanBrush}"
                                                         VerticalAlignment="Center" HorizontalAlignment="Left"
                                                         IsHitTestVisible="False" Focusable="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                              Style="{x:Null}" Background="Transparent"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PathBorder" Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PathBorder" Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                                <Setter TargetName="PathBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PathBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GeneralEmptyPathPlaceholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="42,0,9,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <!-- Each General page scrolls separately from the Settings hero and tabs. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Padding="0,0,8,0" Focusable="False">
        <!-- Legacy named definitions remain for code-behind compatibility, but the
             second column has zero width: this is strictly a one-column layout. -->
        <Grid x:Name="GeneralCardsGrid" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GeneralMainColumn" Width="*"/>
                <ColumnDefinition x:Name="GeneralSideColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. GAME INSTALLATION AND REAL GAME / PLUGINS STATUS -->
            <Border x:Name="GeneralLeftColumn" Grid.Row="0"
                    Style="{StaticResource GeneralSectionPanel}">
                <StackPanel>
                    <Border Style="{StaticResource SettingsSectionHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsHeroIconTile}">
                                <materialDesign:PackIcon Kind="GamepadVariantOutline"
                                                         Style="{StaticResource SettingsHeroGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="League of Legends · Local Game Data"
                                           Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock Text="Select your installation and inspect its Game and Plugins WAD archives."
                                           Style="{StaticResource SettingsHeroSubtitle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="20,16,20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="17" Height="17"
                                                     Foreground="{StaticResource SettingsCyanBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Grid.Column="1" Text="League of Legends installation directory"
                                       Style="{StaticResource GeneralFieldLabel}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Choose the saved League installation root containing Game and Plugins."
                                   Style="{StaticResource GeneralHelpText}" Margin="0,3,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" MinWidth="0">
                                <TextBox x:Name="GameDirectoryPathBox"
                                         Text="{Binding Settings.LeagueGameDirectory, Mode=OneWay}"
                                         Style="{StaticResource GeneralDirectoryPathField}"
                                         IsReadOnly="True"
                                         AutomationProperties.Name="Selected League of Legends game directory"/>
                                <TextBlock Text="No game directory selected">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralEmptyPathPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GameDirectoryPathBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=GameDirectoryPathBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="BrowseGameButton" Grid.Column="1"
                                    Click="SelectLeagueGameDirectory_Click"
                                    Style="{StaticResource SettingsBrowseButton}"
                                    Height="41" Margin="10,0,0,0"
                                    AutomationProperties.Name="Browse League of Legends installation">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="BROWSE" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="The app never replaces your selected game directory automatically."
                                   Style="{StaticResource GeneralHelpText}" Margin="0,7,0,0"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,15"/>
                        <Border x:Name="GeneralRightColumn"
                                Style="{StaticResource SettingsInsetCard}"
                                Padding="13,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon x:Name="GameStatusIcon"
                                                             Kind="InformationOutline" Width="22" Height="22"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="GameStatusTitle"
                                                   Text="Checking saved installation…"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GameStatusDescription"
                                                   Text="Examining local Game and Plugins archives."
                                                   Style="{StaticResource GeneralHelpText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="34,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GAME" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SettingsCyanBrush}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="GameArchiveCountText" Text="—"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" WADs" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="PLUGINS" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SettingsVioletBrush}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PluginArchiveCountText" Text="—"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" WADs" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ActiveGameDirectoryText"
                                           Text="Checking active game assets…"
                                           Style="{StaticResource GeneralHelpText}"
                                           Margin="34,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. MEDIA DIRECTORY AND DICTIONARY LANGUAGE -->
            <Border x:Name="GeneralMediaCard" Grid.Row="1"
                    Style="{StaticResource GeneralSectionPanel}">
                <StackPanel>
                    <Border Style="{StaticResource SettingsSectionHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsHeroIconTile}">
                                <materialDesign:PackIcon Kind="FolderMusicOutline"
                                                         Style="{StaticResource SettingsHeroGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Media Directory &amp; Dictionary"
                                           Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock Text="Audio source folders and dictionary language preference."
                                           Style="{StaticResource SettingsHeroSubtitle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="20,16,20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FolderMusicOutline" Width="17" Height="17"
                                                     Foreground="{StaticResource SettingsCyanBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Grid.Column="1" Text="Default media source directory"
                                       Style="{StaticResource GeneralFieldLabel}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Source folder containing exported champion voice-over event files."
                                   Style="{StaticResource GeneralHelpText}" Margin="0,3,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" MinWidth="0">
                                <TextBox x:Name="MediaDirectoryPathBox"
                                         Text="{Binding Settings.MediaSourceDirectory, Mode=OneWay}"
                                         Style="{StaticResource GeneralDirectoryPathField}"
                                         IsReadOnly="True"
                                         AutomationProperties.Name="Media source directory"/>
                                <TextBlock Text="No media source directory selected">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralEmptyPathPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MediaDirectoryPathBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=MediaDirectoryPathBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Click="SelectMediaDirectory_Click"
                                    Style="{StaticResource SettingsBrowseButton}"
                                    Height="41" Margin="10,0,0,0"
                                    AutomationProperties.Name="Browse voice-over source directory">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="BROWSE" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16"/>
                        <Grid x:Name="GeneralLanguageCard">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Translate" Width="18" Height="18"
                                                             Foreground="{StaticResource SettingsVioletBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Default dictionary language"
                                               Style="{StaticResource GeneralFieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Language selected when you open the Dictionary section."
                                           Style="{StaticResource GeneralHelpText}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding Settings.DefaultDictionaryLanguage}"
                                      Style="{StaticResource ModernComboBoxStyle}" Height="43"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      AutomationProperties.Name="Default dictionary language"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
