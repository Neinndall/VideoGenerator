<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Track's two repeat buttons draw the rail itself.  There is no second
         background rail, so the progress and remaining range stay on one axis. -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Native TickBars bind tick frequency, ticks, range and direction
                             automatically from their Slider templated parent. -->
                        <TickBar x:Name="TopTicks" Grid.Row="0" Grid.Column="1"
                                 Height="4" ReservedSpace="16" Placement="Top"
                                 Fill="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                 IsHitTestVisible="False"/>
                        <TickBar x:Name="BottomTicks" Grid.Row="2" Grid.Column="1"
                                 Height="4" ReservedSpace="16" Placement="Bottom"
                                 Fill="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                 IsHitTestVisible="False"/>
                        <TickBar x:Name="LeftTicks" Grid.Row="1" Grid.Column="0"
                                 Width="4" ReservedSpace="16" Placement="Left"
                                 Fill="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                 IsHitTestVisible="False"/>
                        <TickBar x:Name="RightTicks" Grid.Row="1" Grid.Column="2"
                                 Width="4" ReservedSpace="16" Placement="Right"
                                 Fill="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                 IsHitTestVisible="False"/>

                        <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1"
                               VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- The transparent hit area keeps the thin rail easy to click. -->
                                            <Grid Background="Transparent">
                                                <Border x:Name="Rail"
                                                        Height="6" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource AccentGradientBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                                             Value="Vertical">
                                                    <Setter TargetName="Rail" Property="Height" Value="Auto"/>
                                                    <Setter TargetName="Rail" Property="Width" Value="6"/>
                                                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
                                                    <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Rail"
                                                        Height="6" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="#182740"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                                             Value="Vertical">
                                                    <Setter TargetName="Rail" Property="Height" Value="Auto"/>
                                                    <Setter TargetName="Rail" Property="Width" Value="6"/>
                                                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
                                                    <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Focusable="False" IsTabStop="False"
                                       Width="16" Height="16" UseLayoutRounding="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="ThumbFace"
                                                         Width="14" Height="14"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="#E9F7FF"
                                                         Stroke="{StaticResource AccentBrush}"
                                                         StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#65BDFF" BlurRadius="5"
                                                                          ShadowDepth="0" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbFace" Property="Fill"
                                                            Value="{StaticResource AccentBrushLight}"/>
                                                    <Setter TargetName="ThumbFace" Property="Width" Value="16"/>
                                                    <Setter TargetName="ThumbFace" Property="Height" Value="16"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbFace" Property="Fill"
                                                            Value="{StaticResource TextHighlightBrush}"/>
                                                    <Setter TargetName="ThumbFace" Property="Width" Value="16"/>
                                                    <Setter TargetName="ThumbFace" Property="Height" Value="16"/>
                                                </Trigger>
                                                <!-- Keyboard focus is visible on the thumb, not as a second rail. -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                                             Value="True">
                                                    <Setter TargetName="ThumbFace" Property="Stroke"
                                                            Value="{StaticResource FocusBrush}"/>
                                                    <Setter TargetName="ThumbFace" Property="StrokeThickness" Value="3"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <!-- WPF sizes and positions this selection overlay using PART_Track.
                             It is hidden unless selection range is explicitly enabled. -->
                        <Canvas x:Name="SelectionCanvas" Grid.Row="1" Grid.Column="1"
                                Height="6" VerticalAlignment="Center"
                                IsHitTestVisible="False" ClipToBounds="True"
                                Panel.ZIndex="1">
                            <Rectangle x:Name="PART_SelectionRange"
                                       Width="0" Height="6" Visibility="Collapsed"
                                       Fill="{StaticResource AccentBrushLight}" Opacity="0.4"/>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelectionRangeEnabled" Value="True">
                            <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Horizontal"/>
                                <Condition Property="TickPlacement" Value="TopLeft"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TopTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Horizontal"/>
                                <Condition Property="TickPlacement" Value="BottomRight"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BottomTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Horizontal"/>
                                <Condition Property="TickPlacement" Value="Both"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TopTicks" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BottomTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Vertical"/>
                                <Condition Property="TickPlacement" Value="TopLeft"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Vertical"/>
                                <Condition Property="TickPlacement" Value="BottomRight"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RightTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Orientation" Value="Vertical"/>
                                <Condition Property="TickPlacement" Value="Both"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftTicks" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="RightTicks" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="SelectionCanvas" Property="Height" Value="Auto"/>
                            <Setter TargetName="SelectionCanvas" Property="Width" Value="6"/>
                            <Setter TargetName="SelectionCanvas" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="SelectionCanvas" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="PART_SelectionRange" Property="Width" Value="6"/>
                            <Setter TargetName="PART_SelectionRange" Property="Height" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.36"/>
                            <Setter TargetName="SelectionCanvas" Property="Opacity" Value="0.36"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="150"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Apply the same control to explicitly and implicitly styled sliders. -->
    <Style TargetType="Slider" BasedOn="{StaticResource ModernSlider}"/>

</ResourceDictionary>
