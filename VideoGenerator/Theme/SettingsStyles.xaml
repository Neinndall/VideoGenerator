<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Reuse the application's original navy surfaces and shared accent colors.
         These settings resources are also consumed by real secondary panels. -->
    <SolidColorBrush x:Key="SettingsCyanBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SettingsVioletBrush" Color="{StaticResource AccentColorDark}"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SettingsInsetBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="SettingsIconCyanSurfaceBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="SettingsIconVioletSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}"/>


    <!-- Settings category navigation is a text/icon rail: selection, hover and
         keyboard focus are communicated by foreground color alone. -->
    <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Continue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="0" Margin="0,0,0,14"
                                  HorizontalAlignment="Center" Background="Transparent"/>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Margin="0,0,2,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource FocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Only keyboard navigation gets a subtle neutral focus cue; mouse hover
         and selected state never create the unwanted bright-blue outline. -->
    <Style x:Key="SettingsSwitchKeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#7A9AAA" BorderThickness="1"
                            CornerRadius="15" Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings switches share the reference's cobalt-blue active track.
         No hover border or selected/focused rectangle is painted around them. -->
    <Style x:Key="SettingsSwitchToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsSwitchKeyboardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="48" Height="28" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="Track" Width="46" Height="25"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="13" Background="{StaticResource SettingsSwitchOffBackgroundBrush}"
                                BorderThickness="0"/>
                        <Ellipse x:Name="Thumb" Width="19" Height="19"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="4,0,0,0" Fill="#DDE9FF"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SettingsSwitchOnBackgroundBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WorkspacePanelSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- Shared Settings section chrome. All headers use the same featured
         navy-violet gradient as League of Legends · Local Game Data. Keep the
         header inset within the card stroke so the rounded outer border remains
         visible rather than being painted over by its children. -->
    <Style x:Key="SettingsSectionPanel" TargetType="Border"
           BasedOn="{StaticResource SettingsCard}">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="SettingsSectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsFeaturedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="11,11,0,0"/>
        <Setter Property="Margin" Value="1,1,1,0"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SettingsFeaturedCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
        <Setter Property="Background" Value="{StaticResource SettingsFeaturedBrush}"/>
        <Setter Property="BorderBrush" Value="#1187C4"/>
        <Setter Property="Padding" Value="19"/>
    </Style>
    <Style x:Key="SettingsInsetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsInsetBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <!-- All nine Settings heroes share one icon tile and one glyph treatment.
         Individual icons convey the section purpose, not a different color scheme. -->
    <Style x:Key="SettingsHeroIconTile" TargetType="Border">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource SettingsHeroIconBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="#2C537B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,13,0"/>
    </Style>
    <Style x:Key="SettingsHeroGlyph" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsCyanBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Compact semantic icons for individual Settings controls.
         Hero icon tiles retain their separate, larger style. -->
    <Style x:Key="SettingsFieldGlyph" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsCyanBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="SettingsHeroSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Compatibility keys no longer diverge in appearance from the hero. -->
    <Style x:Key="SettingsCyanIconTile" TargetType="Border" BasedOn="{StaticResource SettingsHeroIconTile}"/>
    <Style x:Key="SettingsVioletIconTile" TargetType="Border" BasedOn="{StaticResource SettingsHeroIconTile}"/>

    <!-- Outline Browse action inspired by the compact Media & Temporary Files
         reference. This style owns the actual chrome and hover behavior;
         inheriting ModernSecondaryButton allowed an unwanted bright/purple
         hover treatment to override the local Settings setters. -->
    <Style x:Key="SettingsBrowseButton" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Background" Value="{StaticResource SettingsBrowseBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SettingsBrowseHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SettingsBrowsePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsCyanBrush}"/>
    </Style>
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingsFieldTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SettingsFieldDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
</ResourceDictionary>
