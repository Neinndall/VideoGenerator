<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Match the reference: ink-dark blue canvas, luminous navy cards. -->
    <Color x:Key="PrimaryBackgroundColor">#030E24</Color>
    <Color x:Key="SecondaryBackgroundColor">#061632</Color>
    <Color x:Key="SurfaceColor">#091C3A</Color>
    <Color x:Key="InputBackgroundColor">#071730</Color>
    <Color x:Key="ElevatedSurfaceColor">#10264B</Color>
    <Color x:Key="HoverSurfaceColor">#143369</Color>
    
    <!-- Brand & Accents -->
    <Color x:Key="AccentColor">#16D6FF</Color>
    <Color x:Key="AccentColorLight">#61E7FF</Color>
    <Color x:Key="AccentColorDark">#5134FF</Color>
    <Color x:Key="AccentSoftColor">#103064</Color>
    <Color x:Key="HextechGoldColor">#C89B3C</Color>
    
    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#10B981</Color> 
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorColorLight">#F87171</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="CancelColor">#F97316</Color> <!-- Orange -->

    <!-- Border & Dividers -->
    <Color x:Key="BorderColor">#183861</Color>
    <Color x:Key="BorderColorBright">#2C6BAC</Color>
    <Color x:Key="DividerColor">#193454</Color>
    <Color x:Key="FocusColor">#2DDEFF</Color>
    
    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F3F7FF</Color>
    <Color x:Key="TextSecondaryColor">#BBCDF2</Color>
    <Color x:Key="TextMutedColor">#819BCB</Color>
    <Color x:Key="TextTertiaryColor">#94B0DD</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentColorLight}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="HextechGoldBrush" Color="{StaticResource HextechGoldColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource BorderColorBright}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBrushLight" Color="{StaticResource ErrorColorLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="CancelBrush" Color="{StaticResource CancelColor}"/>

    <!-- Shell-specific treatments are reusable by Settings and workspace panels. -->
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ElectricVioletBrush" Color="{StaticResource AccentColorDark}"/>
    <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#244B80"/>
    <SolidColorBrush x:Key="ShellNavSelectedBorderBrush" Color="#286AD5"/>
    <!-- One opaque paint for the entire navigation column. No inset radial
         overlays: those caused visible bands where its padded content begins. -->
    <SolidColorBrush x:Key="ShellSidebarUniformBrush" Color="#061531"/>
    <LinearGradientBrush x:Key="ShellCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#102B51" Offset="0"/>
        <GradientStop Color="#091D3D" Offset="0.55"/>
        <GradientStop Color="#071631" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071432" Offset="0"/>
        <GradientStop Color="#030A21" Offset="0.38"/>
        <GradientStop Color="#06122D" Offset="1"/>
    </LinearGradientBrush>
    <!-- Original sidebar has a deep central vignette and low luminous blue bloom. -->
    <RadialGradientBrush x:Key="ShellSidebarVignetteBrush"
                         Center="0.52,0.22" GradientOrigin="0.52,0.22"
                         RadiusX="0.69" RadiusY="0.36">
        <GradientStop Color="#B5000011" Offset="0"/>
        <GradientStop Color="#5A000016" Offset="0.42"/>
        <GradientStop Color="#00000017" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShellSidebarAtmosphereBrush"
                         Center="0.35,0.55" GradientOrigin="0.35,0.55"
                         RadiusX="1.1" RadiusY="0.46">
        <GradientStop Color="#35133470" Offset="0"/>
        <GradientStop Color="#1914335B" Offset="0.53"/>
        <GradientStop Color="#00132248" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ShellTopBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#020B20" Offset="0"/>
        <GradientStop Color="#02091C" Offset="0.25"/>
        <GradientStop Color="#031024" Offset="0.65"/>
        <GradientStop Color="#020B1D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellContentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#021027" Offset="0"/>
        <GradientStop Color="#04142B" Offset="0.46"/>
        <GradientStop Color="#020B1E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E3D87" Offset="0"/>
        <GradientStop Color="#0C286F" Offset="0.5"/>
        <GradientStop Color="#1B2AAC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#102F61" Offset="0"/>
        <GradientStop Color="#172A66" Offset="1"/>
    </LinearGradientBrush>

    <!-- Semi-transparent Semantic Brushes for Badges, Alerts, and Pills -->
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.05"/>
    <SolidColorBrush x:Key="InfoSoftBorderBrush" Color="{StaticResource InfoColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.25"/>
    <SolidColorBrush x:Key="SuccessPillBgBrush" Color="{StaticResource SuccessColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="SuccessPillBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="WarningPillBgBrush" Color="{StaticResource WarningColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="WarningPillBorderBrush" Color="{StaticResource WarningColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="ErrorPillBgBrush" Color="{StaticResource ErrorColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="ErrorPillBorderBrush" Color="{StaticResource ErrorColor}" Opacity="0.5"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#36BBFF" Offset="0"/>
        <GradientStop Color="#2475FF" Offset="0.47"/>
        <GradientStop Color="{StaticResource AccentColorDark}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="CancelGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0"/>
        <GradientStop Color="{StaticResource CancelColor}" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>
