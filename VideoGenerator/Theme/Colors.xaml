<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Match the reference: ink-dark blue canvas, luminous navy cards. -->
    <Color x:Key="PrimaryBackgroundColor">#030E24</Color>
    <Color x:Key="SecondaryBackgroundColor">#061632</Color>
    <Color x:Key="SurfaceColor">#091C3A</Color>
    <Color x:Key="InputBackgroundColor">#071730</Color>
    <Color x:Key="ElevatedSurfaceColor">#10264B</Color>
    <Color x:Key="HoverSurfaceColor">#143369</Color>

    <!-- Semantic background colors. Change these instead of painting each view.
         Canvas = MainWindow; panel = cards; content well = the dark area inside them. -->
    <Color x:Key="WorkspaceContentWellColor">#061125</Color>
    <Color x:Key="WorkspaceFilterBarColor">#0C1E3B</Color>
    <Color x:Key="WorkspaceConsoleHeaderColor">#10233F</Color>
    <Color x:Key="WorkspacePanelBorderColor">#25456C</Color>
    <Color x:Key="WorkspaceInspectorBorderColor">#275581</Color>
    <Color x:Key="WorkspaceHeaderBorderColor">#3566A3</Color>
    <Color x:Key="WorkspaceConsoleHeaderBorderColor">#254362</Color>
    <Color x:Key="RenderTimelineTrackColor">#0B1729</Color>
    <Color x:Key="RenderTimelineClipColor">#25446E</Color>
    <Color x:Key="RenderTimelineMusicColor">#41365F</Color>
    
    <!-- Brand & Accents -->
    <Color x:Key="AccentColor">#16D6FF</Color>
    <Color x:Key="AccentColorLight">#61E7FF</Color>
    <Color x:Key="AccentColorDark">#5134FF</Color>
    <Color x:Key="AccentSoftColor">#103064</Color>
    <Color x:Key="HextechGoldColor">#C89B3C</Color>
    
    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#10B981</Color> 
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorColorLight">#F87171</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="CancelColor">#F97316</Color> <!-- Orange -->

    <!-- Border & Dividers -->
    <Color x:Key="BorderColor">#183861</Color>
    <Color x:Key="BorderColorBright">#2C6BAC</Color>
    <Color x:Key="DividerColor">#193454</Color>
    <Color x:Key="FocusColor">#2DDEFF</Color>
    
    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F3F7FF</Color>
    <Color x:Key="TextSecondaryColor">#BBCDF2</Color>
    <Color x:Key="TextMutedColor">#819BCB</Color>
    <Color x:Key="TextTertiaryColor">#94B0DD</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}"/>

    <!-- CONTENT WELL: same opaque paint for empty/full Pipeline, Live Preview,
         Engine Console and video-monitor preview; avoids nested rectangles. -->
    <SolidColorBrush x:Key="WorkspaceContentWellBrush" Color="{StaticResource WorkspaceContentWellColor}"/>
    <!-- FILTER STRIP: filter tabs directly above a content well. -->
    <SolidColorBrush x:Key="WorkspaceFilterBarBrush" Color="{StaticResource WorkspaceFilterBarColor}"/>
    <!-- CONSOLE HEADER: a restrained raised strip, separate from the console body. -->
    <SolidColorBrush x:Key="WorkspaceConsoleHeaderBrush" Color="{StaticResource WorkspaceConsoleHeaderColor}"/>
    <SolidColorBrush x:Key="WorkspacePanelBorderBrush" Color="{StaticResource WorkspacePanelBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceInspectorBorderBrush" Color="{StaticResource WorkspaceInspectorBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceHeaderBorderBrush" Color="{StaticResource WorkspaceHeaderBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceConsoleHeaderBorderBrush" Color="{StaticResource WorkspaceConsoleHeaderBorderColor}"/>

    <!-- VIDEO EDITOR: individual video/music tracks intentionally remain recognizable
         above the shared content well. Use the same keys in all timeline views. -->
    <SolidColorBrush x:Key="RenderTimelineTrackBrush" Color="{StaticResource RenderTimelineTrackColor}"/>
    <SolidColorBrush x:Key="RenderTimelineClipBrush" Color="{StaticResource RenderTimelineClipColor}"/>
    <SolidColorBrush x:Key="RenderTimelineMusicBrush" Color="{StaticResource RenderTimelineMusicColor}"/>
    <SolidColorBrush x:Key="VideoPreviewLabelBrush" Color="#CC161618"/>
    <SolidColorBrush x:Key="DesignerPreviewLabelBrush" Color="#E60D0D0F"/>
    <!-- Exact export/preview canvas is deliberately neutral, unlike the app chrome. -->
    <SolidColorBrush x:Key="DesignerRenderCanvasBrush" Color="#020202"/>

    <!-- LISTS AND INPUTS: hover/selected/focus states are semantic, not arbitrary
         per-view colors. Selection has more contrast than a passive hovered row. -->
    <SolidColorBrush x:Key="DashboardCheckBackgroundBrush" Color="#0B1933"/>
    <SolidColorBrush x:Key="DashboardRowHoverBrush" Color="#112B4B"/>
    <SolidColorBrush x:Key="DashboardRowSelectedBrush" Color="#163F69"/>
    <SolidColorBrush x:Key="DashboardStatusBadgeBrush" Color="#132138"/>
    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#17365C"/>
    <SolidColorBrush x:Key="ComboItemHighlightedBrush" Color="#193E66"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#173C60"/>
    <SolidColorBrush x:Key="ComboPopupBackgroundBrush" Color="#0B1C37"/>
    <SolidColorBrush x:Key="TextInputHoverBrush" Color="#1C2B48"/>
    <SolidColorBrush x:Key="TextInputFocusBrush" Color="#193653"/>
    <SolidColorBrush x:Key="SidebarNavHoverBackgroundBrush" Color="#102642"/>
    <SolidColorBrush x:Key="SidebarNavSelectedBackgroundBrush" Color="#132D4C"/>
    <SolidColorBrush x:Key="SidebarNavFocusedBackgroundBrush" Color="#193957"/>
    <SolidColorBrush x:Key="RichTextConsoleBackgroundBrush" Color="#061021"/>
    <SolidColorBrush x:Key="ScrollBarArrowHoverBrush" Color="#16243B"/>
    <SolidColorBrush x:Key="SliderUnfilledTrackBrush" Color="#182740"/>
    <SolidColorBrush x:Key="ProgressTrackBackgroundBrush" Color="#2D2D30"/>

    <!-- SETTINGS: switch, icon tiles, and browse-button interaction states. -->
    <SolidColorBrush x:Key="SettingsSwitchOffBackgroundBrush" Color="#273449"/>
    <SolidColorBrush x:Key="SettingsSwitchOnBackgroundBrush" Color="#2769F3"/>
    <SolidColorBrush x:Key="SettingsHeroIconBackgroundBrush" Color="#102B4E"/>
    <SolidColorBrush x:Key="SettingsBrowseBackgroundBrush" Color="#0B1C38"/>
    <SolidColorBrush x:Key="SettingsBrowseHoverBrush" Color="#12284A"/>
    <SolidColorBrush x:Key="SettingsBrowsePressedBrush" Color="#18385A"/>

    <!-- SHELL / ACTIONS: status rail and translucent metric badge. -->
    <SolidColorBrush x:Key="ShellTopBarTagBackgroundBrush" Color="#141E40AF"/>
    <SolidColorBrush x:Key="ShellStatusBarBackgroundBrush" Color="#06152E"/>
    <SolidColorBrush x:Key="CancelButtonPressedBackgroundBrush" Color="#F58C49"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentColorLight}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="HextechGoldBrush" Color="{StaticResource HextechGoldColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource BorderColorBright}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBrushLight" Color="{StaticResource ErrorColorLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="CancelBrush" Color="{StaticResource CancelColor}"/>

    <!-- Shell-specific treatments are reusable by Settings and workspace panels. -->
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ElectricVioletBrush" Color="{StaticResource AccentColorDark}"/>
    <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#244B80"/>
    <SolidColorBrush x:Key="ShellNavSelectedBorderBrush" Color="#286AD5"/>
    <!-- One opaque paint for the entire navigation column. No inset radial
         overlays: those caused visible bands where its padded content begins. -->
    <SolidColorBrush x:Key="ShellSidebarUniformBrush" Color="#061531"/>
    <!-- CARD SURFACES: large neutral cards / dialogs, shared by Settings and workspaces. -->
    <LinearGradientBrush x:Key="WorkspacePanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1C37" Offset="0"/>
        <GradientStop Color="#0A1730" Offset="0.64"/>
        <GradientStop Color="#0C1C39" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceContainerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1D37" Offset="0"/>
        <GradientStop Color="#0A1730" Offset="0.63"/>
        <GradientStop Color="#101A39" Offset="1"/>
    </LinearGradientBrush>
    <!-- HEADERS: common card headers, featured titles and inspector are separate
         semantic layers; do not replace them with the darkest content well. -->
    <LinearGradientBrush x:Key="WorkspacePanelHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12315A" Offset="0"/>
        <GradientStop Color="#0E2242" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SectionHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10284B" Offset="0"/>
        <GradientStop Color="#101D38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WorkspaceHeaderSurfaceBrush" StartPoint="0,0" EndPoint="1,0.6">
        <GradientStop Color="#102B54" Offset="0"/>
        <GradientStop Color="#101F42" Offset="0.62"/>
        <GradientStop Color="#161D48" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SettingsFeaturedBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#102B54" Offset="0"/>
        <GradientStop Color="#101F42" Offset="0.62"/>
        <GradientStop Color="#161D48" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WorkspaceInspectorSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10274A" Offset="0"/>
        <GradientStop Color="#0C1B37" Offset="0.55"/>
        <GradientStop Color="#0C2147" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#395F87" Offset="0"/>
        <GradientStop Color="#223C5D" Offset="0.58"/>
        <GradientStop Color="#00223C5D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellTopBarLabelDividerBrush" Color="#254471"/>
    <SolidColorBrush x:Key="ShellTopBarMetricDividerBrush" Color="#264572"/>

    <!-- INTERACTION SURFACES: buttons, lists and scrollbars share the same
         theme authority; these keys are consumed by their control styles. -->
    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#93D5FF" Offset="0"/>
        <GradientStop Color="#7770FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#203453" Offset="0"/>
        <GradientStop Color="#151F37" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#294A70" Offset="0"/>
        <GradientStop Color="#242646" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyListSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#234365" Offset="0"/>
        <GradientStop Color="#1C2747" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyListSelectionHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#28577B" Offset="0"/>
        <GradientStop Color="#282A54" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#536D99"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#75C9FF"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#9ADFFF"/>
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <LinearGradientBrush x:Key="ShellCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#102B51" Offset="0"/>
        <GradientStop Color="#091D3D" Offset="0.55"/>
        <GradientStop Color="#071631" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071432" Offset="0"/>
        <GradientStop Color="#030A21" Offset="0.38"/>
        <GradientStop Color="#06122D" Offset="1"/>
    </LinearGradientBrush>
    <!-- Original sidebar has a deep central vignette and low luminous blue bloom. -->
    <RadialGradientBrush x:Key="ShellSidebarVignetteBrush"
                         Center="0.52,0.22" GradientOrigin="0.52,0.22"
                         RadiusX="0.69" RadiusY="0.36">
        <GradientStop Color="#B5000011" Offset="0"/>
        <GradientStop Color="#5A000016" Offset="0.42"/>
        <GradientStop Color="#00000017" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShellSidebarAtmosphereBrush"
                         Center="0.35,0.55" GradientOrigin="0.35,0.55"
                         RadiusX="1.1" RadiusY="0.46">
        <GradientStop Color="#35133470" Offset="0"/>
        <GradientStop Color="#1914335B" Offset="0.53"/>
        <GradientStop Color="#00132248" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ShellTopBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#020B20" Offset="0"/>
        <GradientStop Color="#02091C" Offset="0.25"/>
        <GradientStop Color="#031024" Offset="0.65"/>
        <GradientStop Color="#020B1D" Offset="1"/>
    </LinearGradientBrush>
    <!-- Quiet ink-navy workspace canvas, gently lifted to smoky midnight blue
         toward the upper-right. Keep the brighter panels and sidebar distinct. -->
    <LinearGradientBrush x:Key="ShellContentGradientBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#080D1B" Offset="0"/>
        <GradientStop Color="#0B1022" Offset="0.48"/>
        <GradientStop Color="#12152C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E3D87" Offset="0"/>
        <GradientStop Color="#0C286F" Offset="0.5"/>
        <GradientStop Color="#1B2AAC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#102F61" Offset="0"/>
        <GradientStop Color="#172A66" Offset="1"/>
    </LinearGradientBrush>

    <!-- Semi-transparent Semantic Brushes for Badges, Alerts, and Pills -->
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.05"/>
    <SolidColorBrush x:Key="InfoSoftBorderBrush" Color="{StaticResource InfoColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.25"/>
    <SolidColorBrush x:Key="SuccessPillBgBrush" Color="{StaticResource SuccessColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="SuccessPillBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="WarningPillBgBrush" Color="{StaticResource WarningColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="WarningPillBorderBrush" Color="{StaticResource WarningColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="ErrorPillBgBrush" Color="{StaticResource ErrorColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="ErrorPillBorderBrush" Color="{StaticResource ErrorColor}" Opacity="0.5"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#36BBFF" Offset="0"/>
        <GradientStop Color="#2475FF" Offset="0.47"/>
        <GradientStop Color="{StaticResource AccentColorDark}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="CancelGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0"/>
        <GradientStop Color="{StaticResource CancelColor}" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>
