<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Midnight-navy foundation: deep, noble space-navy matching the concept reference -->
    <Color x:Key="PrimaryBackgroundColor">#040D22</Color>
    <Color x:Key="SecondaryBackgroundColor">#06132D</Color>
    <Color x:Key="SurfaceColor">#071630</Color>
    <Color x:Key="InputBackgroundColor">#030919</Color>
    <Color x:Key="ElevatedSurfaceColor">#0A1E42</Color>
    <Color x:Key="HoverSurfaceColor">#0E2856</Color>

    <!-- Surface hierarchy: quiet, deeply dark midnight-navy canvas, low-saturation inset
         surfaces and subtly elevated headers. Dark, cinematic content wells. -->
    <Color x:Key="WorkspaceContentWellColor">#020612</Color>
    <Color x:Key="WorkspaceFilterBarColor">#051124</Color>
    <Color x:Key="WorkspaceConsoleHeaderColor">#051126</Color>
    <Color x:Key="WorkspacePanelBorderColor">#102644</Color>
    <Color x:Key="WorkspaceInspectorBorderColor">#15335A</Color>
    <Color x:Key="WorkspaceHeaderBorderColor">#1A3E6D</Color>
    <Color x:Key="WorkspaceConsoleHeaderBorderColor">#0D2039</Color>
    <Color x:Key="RenderTimelineTrackColor">#040B1A</Color>
    <Color x:Key="RenderTimelineClipColor">#19375F</Color>
    <Color x:Key="RenderTimelineAudioClipColor">#341620</Color>
    <Color x:Key="RenderTimelineAudioWaveformColor">#22D3EE</Color>
    <Color x:Key="RenderTimelineVideoHeaderColor">#16325C</Color>
    <Color x:Key="RenderTimelineAudioHeaderColor">#3D1722</Color>
    <Color x:Key="RenderTimelineMusicHeaderColor">#2A1338</Color>
    <Color x:Key="RenderTimelineVegasSelectedColor">#FACC15</Color>
    <Color x:Key="RenderTimelineMusicColor">#30264B</Color>
    
    <!-- Brand & Accents -->
    <Color x:Key="AccentColor">#16D6FF</Color>
    <Color x:Key="AccentColorLight">#61E7FF</Color>
    <Color x:Key="AccentColorDark">#5134FF</Color>
    <Color x:Key="AccentSoftColor">#0D254C</Color>
    <Color x:Key="HextechGoldColor">#C89B3C</Color>
    
    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#10B981</Color> 
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorColorLight">#F87171</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="CancelColor">#F97316</Color> <!-- Orange -->

    <!-- Border & Dividers -->
    <Color x:Key="BorderColor">#0E223D</Color>
    <Color x:Key="BorderColorBright">#1A467E</Color>
    <Color x:Key="DividerColor">#0D203A</Color>
    <Color x:Key="FocusColor">#2570EB</Color>
    
    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F3F7FF</Color>
    <Color x:Key="TextSecondaryColor">#A9BFE4</Color>
    <Color x:Key="TextMutedColor">#6882AC</Color>
    <Color x:Key="TextTertiaryColor">#7E98C2</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}"/>

    <!-- CONTENT WELL: deeply dark, immersive midnight screen shared by Pipeline,
         Preview, Console and video monitor; provides true contrast for preview content. -->
    <SolidColorBrush x:Key="WorkspaceContentWellBrush" Color="{StaticResource WorkspaceContentWellColor}"/>
    <!-- FILTER STRIP: subtle filter tabs directly above a content well. -->
    <SolidColorBrush x:Key="WorkspaceFilterBarBrush" Color="{StaticResource WorkspaceFilterBarColor}"/>
    <!-- CONSOLE HEADER: harmonized with shared workspace panel header gradient. -->
    <LinearGradientBrush x:Key="WorkspaceConsoleHeaderBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#0C2248" Offset="0"/>
        <GradientStop Color="#081836" Offset="0.62"/>
        <GradientStop Color="#0C1B42" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WorkspacePanelBorderBrush" Color="{StaticResource WorkspacePanelBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceInspectorBorderBrush" Color="{StaticResource WorkspaceInspectorBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceHeaderBorderBrush" Color="{StaticResource WorkspaceHeaderBorderColor}"/>
    <SolidColorBrush x:Key="WorkspaceConsoleHeaderBorderBrush" Color="{StaticResource WorkspaceConsoleHeaderBorderColor}"/>

    <!-- VIDEO EDITOR: individual video/music tracks intentionally remain recognizable
         above the shared content well. Use the same keys in all timeline views. -->
    <SolidColorBrush x:Key="RenderTimelineTrackBrush" Color="{StaticResource RenderTimelineTrackColor}"/>
    <SolidColorBrush x:Key="RenderTimelineClipBrush" Color="{StaticResource RenderTimelineClipColor}"/>
    <SolidColorBrush x:Key="RenderTimelineAudioClipBrush" Color="{StaticResource RenderTimelineAudioClipColor}"/>
    <SolidColorBrush x:Key="RenderTimelineAudioWaveformBrush" Color="{StaticResource RenderTimelineAudioWaveformColor}"/>
    <SolidColorBrush x:Key="RenderTimelineVideoHeaderBrush" Color="{StaticResource RenderTimelineVideoHeaderColor}"/>
    <SolidColorBrush x:Key="RenderTimelineAudioHeaderBrush" Color="{StaticResource RenderTimelineAudioHeaderColor}"/>
    <SolidColorBrush x:Key="RenderTimelineMusicHeaderBrush" Color="{StaticResource RenderTimelineMusicHeaderColor}"/>
    <SolidColorBrush x:Key="RenderTimelineVegasSelectedBrush" Color="{StaticResource RenderTimelineVegasSelectedColor}"/>
    <SolidColorBrush x:Key="RenderTimelineMusicBrush" Color="{StaticResource RenderTimelineMusicColor}"/>
    <SolidColorBrush x:Key="VideoPreviewLabelBrush" Color="#CC161618"/>
    <SolidColorBrush x:Key="DesignerPreviewLabelBrush" Color="#E60D0D0F"/>
    <!-- Exact export/preview canvas is deliberately neutral, unlike the app chrome. -->
    <SolidColorBrush x:Key="DesignerRenderCanvasBrush" Color="#020202"/>

    <!-- LISTS AND INPUTS: hover/selected/focus states are semantic, not arbitrary
         per-view colors. Selection has crisp contrast and glowing presence. -->
    <SolidColorBrush x:Key="DashboardCheckBackgroundBrush" Color="#040D1E"/>
    <SolidColorBrush x:Key="DashboardRowHoverBrush" Color="#071732"/>
    <SolidColorBrush x:Key="DashboardRowSelectedBrush" Color="#0A244E"/>
    <SolidColorBrush x:Key="DashboardStatusBadgeBrush" Color="#040D1E"/>
    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#0D2447"/>
    <SolidColorBrush x:Key="ComboItemHighlightedBrush" Color="#102D58"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#0C254A"/>
    <SolidColorBrush x:Key="ComboPopupBackgroundBrush" Color="#071630"/>
    <SolidColorBrush x:Key="TextInputHoverBrush" Color="#06142B"/>
    <SolidColorBrush x:Key="TextInputFocusBrush" Color="#081834"/>
    <SolidColorBrush x:Key="SidebarNavHoverBackgroundBrush" Color="#081938"/>
    <!-- Selected navigation item uses rich glowing gradient below -->
    <!-- Selected navigation item: soft, refined midnight-navy elevation (harmonized with hover) -->
    <LinearGradientBrush x:Key="SidebarNavSelectedBackgroundBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#0A2246" Offset="0"/>
        <GradientStop Color="#0C204E" Offset="0.5"/>
        <GradientStop Color="#10225A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarNavFocusedBackgroundBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#0D2952" Offset="0"/>
        <GradientStop Color="#0F285C" Offset="0.5"/>
        <GradientStop Color="#142B6A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RichTextConsoleBackgroundBrush" Color="#020612"/>
    <SolidColorBrush x:Key="ScrollBarArrowHoverBrush" Color="#0D1E36"/>
    <SolidColorBrush x:Key="SliderUnfilledTrackBrush" Color="#0D1B2E"/>
    <SolidColorBrush x:Key="ProgressTrackBackgroundBrush" Color="#182335"/>

    <!-- SETTINGS: switch, icon tiles, and browse-button interaction states. -->
    <SolidColorBrush x:Key="SettingsSwitchOffBackgroundBrush" Color="#18273E"/>
    <SolidColorBrush x:Key="SettingsSwitchOnBackgroundBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SettingsHeroIconBackgroundBrush" Color="#0C2244"/>
    <SolidColorBrush x:Key="SettingsBrowseBackgroundBrush" Color="#071732"/>
    <SolidColorBrush x:Key="SettingsBrowseHoverBrush" Color="#0D244A"/>
    <SolidColorBrush x:Key="SettingsBrowsePressedBrush" Color="#123162"/>

    <!-- SHELL / ACTIONS: status rail and translucent metric badge. -->
    <SolidColorBrush x:Key="ShellTopBarTagBackgroundBrush" Color="#141E40AF"/>
    <SolidColorBrush x:Key="CancelButtonPressedBackgroundBrush" Color="#F58C49"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentColorLight}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="HextechGoldBrush" Color="{StaticResource HextechGoldColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource BorderColorBright}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBrushLight" Color="{StaticResource ErrorColorLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="CancelBrush" Color="{StaticResource CancelColor}"/>

    <!-- Shell-specific treatments are reusable by Settings and workspace panels. -->
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ElectricVioletBrush" Color="{StaticResource AccentColorDark}"/>
    <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#153660"/>
    <SolidColorBrush x:Key="ShellNavSelectedBorderBrush" Color="#1E4E8E"/>
    <!-- CARD SURFACES: large neutral cards / dialogs, shared by Settings and workspaces. -->
    <LinearGradientBrush x:Key="WorkspacePanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#051226" Offset="0"/>
        <GradientStop Color="#040D1E" Offset="0.65"/>
        <GradientStop Color="#051022" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceContainerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#051226" Offset="0"/>
        <GradientStop Color="#040D1E" Offset="0.65"/>
        <GradientStop Color="#051022" Offset="1"/>
    </LinearGradientBrush>
    <!-- HEADERS: common card headers, featured titles and inspector are separate
         semantic layers; do not replace them with the darkest content well. -->
    <LinearGradientBrush x:Key="WorkspacePanelHeaderBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#0C2248" Offset="0"/>
        <GradientStop Color="#081836" Offset="0.62"/>
        <GradientStop Color="#0C1B42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SectionHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#0C2248" Offset="0"/>
        <GradientStop Color="#081836" Offset="0.62"/>
        <GradientStop Color="#0C1B42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WorkspaceHeaderSurfaceBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#0C2248" Offset="0"/>
        <GradientStop Color="#081836" Offset="0.62"/>
        <GradientStop Color="#0C1B42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SettingsFeaturedBrush" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Color="#0C2248" Offset="0"/>
        <GradientStop Color="#081836" Offset="0.62"/>
        <GradientStop Color="#0C1B42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WorkspaceInspectorSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#081835" Offset="0"/>
        <GradientStop Color="#06132B" Offset="0.55"/>
        <GradientStop Color="#081938" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1C3D68" Offset="0"/>
        <GradientStop Color="#0F2442" Offset="0.58"/>
        <GradientStop Color="#000F2442" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellTopBarLabelDividerBrush" Color="#132B4C"/>
    <SolidColorBrush x:Key="ShellTopBarMetricDividerBrush" Color="#132B4C"/>

    <!-- INTERACTION SURFACES: buttons, lists and scrollbars share the same
         theme authority; these keys are consumed by their control styles. -->
    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#53C4FF" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="0.45"/>
        <GradientStop Color="#6366F1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#081834" Offset="0"/>
        <GradientStop Color="#051024" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E264E" Offset="0"/>
        <GradientStop Color="#091A38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyListSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0D2954" Offset="0"/>
        <GradientStop Color="#081A38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavyListSelectionHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12356B" Offset="0"/>
        <GradientStop Color="#0E234A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#2A4872"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#4A7AB8"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#689EE0"/>
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <LinearGradientBrush x:Key="ShellCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A1D3D" Offset="0"/>
        <GradientStop Color="#06142E" Offset="0.55"/>
        <GradientStop Color="#051026" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05112B" Offset="0"/>
        <GradientStop Color="#030A1F" Offset="0.38"/>
        <GradientStop Color="#040D24" Offset="1"/>
    </LinearGradientBrush>
    <!-- Original sidebar has a deep central vignette and low luminous blue bloom. -->
    <RadialGradientBrush x:Key="ShellSidebarVignetteBrush"
                         Center="0.52,0.22" GradientOrigin="0.52,0.22"
                         RadiusX="0.69" RadiusY="0.36">
        <GradientStop Color="#B5000011" Offset="0"/>
        <GradientStop Color="#5A000016" Offset="0.42"/>
        <GradientStop Color="#00000017" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShellSidebarAtmosphereBrush"
                         Center="0.35,0.55" GradientOrigin="0.35,0.55"
                         RadiusX="1.1" RadiusY="0.46">
        <GradientStop Color="#35133470" Offset="0"/>
        <GradientStop Color="#1914335B" Offset="0.53"/>
        <GradientStop Color="#00132248" Offset="1"/>
    </RadialGradientBrush>
    <!-- Shared shell chrome: top WORKSPACE bar, full-height sidebar and bottom
         SYSTEM STATUS bar all use this exact same background with deep, noble midnight-navy tones. -->
    <!-- Shared shell chrome: top WORKSPACE bar, full-height sidebar and bottom
         SYSTEM STATUS bar all use this exact same background with smooth, uniform midnight navy
         (vertical orientation eliminates any vertical color striping down the sidebar). -->
    <LinearGradientBrush x:Key="ShellChromeGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#040D22" Offset="0"/>
        <GradientStop Color="#030B1F" Offset="0.5"/>
        <GradientStop Color="#030A1C" Offset="1"/>
    </LinearGradientBrush>
    <!-- MainWindow content canvas: deeply dark midnight navy, quiet and atmospheric,
         eliminating the washed-out blue effect and making panels float with rich contrast. -->
    <LinearGradientBrush x:Key="ShellContentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#020716" Offset="0"/>
        <GradientStop Color="#030B22" Offset="0.48"/>
        <GradientStop Color="#020614" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavSelectedBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#0A2246" Offset="0"/>
        <GradientStop Color="#0C204E" Offset="0.5"/>
        <GradientStop Color="#10225A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellNavHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A2046" Offset="0"/>
        <GradientStop Color="#0C1D42" Offset="1"/>
    </LinearGradientBrush>

    <!-- Semi-transparent Semantic Brushes for Badges, Alerts, and Pills -->
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.05"/>
    <SolidColorBrush x:Key="InfoSoftBorderBrush" Color="{StaticResource InfoColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.25"/>
    <SolidColorBrush x:Key="SuccessPillBgBrush" Color="{StaticResource SuccessColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="SuccessPillBorderBrush" Color="{StaticResource SuccessColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="WarningPillBgBrush" Color="{StaticResource WarningColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="WarningPillBorderBrush" Color="{StaticResource WarningColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="ErrorPillBgBrush" Color="{StaticResource ErrorColor}" Opacity="0.1"/>
    <SolidColorBrush x:Key="ErrorPillBorderBrush" Color="{StaticResource ErrorColor}" Opacity="0.5"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E75E8" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="0.48"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="CancelGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0"/>
        <GradientStop Color="{StaticResource CancelColor}" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>
