<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shell geometry and saturation follow the dark navy visual language. -->
    <Style x:Key="AppShellSidebar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellChromeGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="14,18,8,14"/>
    </Style>

    <Style x:Key="AppShellBrandMark" TargetType="Border">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <!-- The rounded gradient is in logo.png, shared with logo.ico. -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#175CFF" BlurRadius="23" ShadowDepth="0" Opacity="0.65"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppShellBrandTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="17.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="AppShellBrandSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.52"/>
    </Style>

    <Style x:Key="AppShellSidebarDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource ShellSidebarDividerBrush}"/>
    </Style>
    <Style x:Key="AppShellSidebarFooterText" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelText}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="AppShellNavSectionText" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelText}">
        <Setter Property="Margin" Value="15,0,0,10"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#93AEDD"/>
    </Style>
    <Style x:Key="AppShellNavShortcutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppShellContent" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellContentGradientBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="AppShellTopBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellChromeGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="24,7"/>
    </Style>

    <Style x:Key="AppShellSidebarToggleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextHighlightBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrushLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppShellTopMetricPill" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <Style x:Key="AppShellTopBarTag" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{StaticResource ShellTopBarTagBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="#404C6FFF"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="AppShellTopMetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#90ACDA"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style x:Key="AppShellTopMetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AppShellTopMetricSeparator" TargetType="TextBlock" BasedOn="{StaticResource AppShellTopMetricValue}">
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="AppShellStatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellChromeGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="24,8"/>
        <Setter Property="MinHeight" Value="46"/>
    </Style>

    <Style x:Key="AppShellStatusBadge" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessSoftBorderBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>

    <Style x:Key="AppShellProgressLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelText}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
</ResourceDictionary>
